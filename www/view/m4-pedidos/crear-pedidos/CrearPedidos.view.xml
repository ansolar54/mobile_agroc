<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m4-pedidos.CrearPedidos"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderGP01}"
        class="custBackgroundColor"
    >
        <content>
            <l:VerticalLayout
                id="panelMsgStripCP"
                visible="{local>/visible/Panel}"
                class="sapUiResponsiveMargin sapUiNoMarginTop sapUiNoMarginBegin"
            />
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <!-- Row 1: 3 Inputs -->
                    <!-- ORG.VENTAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OrgVentas}:"
                            labelFor="txtOrgVentasCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtOrgVentasCP"
                            value="{local>/OrgVentas}"
                            liveChange="onChange($event, 'OrgVentas')"
                            submit="onPress($event, 'OrgVentas')"
                            change=".onEvaluarPos"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeOrgVentas"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOrgVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                            maxSuggestionWidth="350px"
                            valueStateText="{i18n>ValorInvalido}"
                            startSuggestion="0"
                            maxLength="4"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                    text="{oDataMCOrgVentas>Vkorg}"
                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            id="txtOrgVentasCPInfo"
                            text="{local>/OrgVentasInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M4 S12" />
                        </layoutData>
                    </HBox>
                    <!-- CANAL DISTRIB. -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>CanalDistrib}:"
                            labelFor="txtCanalDistCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtCanalDistCP"
                            value="{local>/CanalDist}"
                            editable="false"
                            width="5rem"
                        />
                        <Text
                            id="txtCanalDistCPInfo"
                            text="{local>/CanalDistInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M4 S12" />
                        </layoutData>
                    </HBox>
                    <!-- SECTOR -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Sector}:"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Sector}"
                            width="5rem"
                            editable="false"
                        />
                        <Text
                            text="{local>/SectorInfo}"
                            class="sapUiTinyMargin"
                            wrapping="false"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M4 S12" />
                        </layoutData>
                    </HBox>
                    <!-- Row 2: 1 Input -->
                    <!-- SOLICITANTE -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Solicitante}:"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtSolicitanteCP"
                            value="{local>/Solicitante}"
                            submit="onPress($event, 'Solicitante')"
                            change=".onEvaluarPos"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeSolicitante"
                            valueStateText="{i18n>ValorInvalido}"
                            width="8rem"
                        >
                            <!-- showSuggestion="true"
                            suggestionItems="{oDataMCSolicitante>/creapedi_solicitantes_nav/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'SOLICITANTE')" -->
                            <!-- <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCSolicitante>Kunnr}"
                                    text="{oDataMCSolicitante>Kunnr}"
                                    additionalText="{oDataMCSolicitante>Name1}"
                                />
                            </suggestionItems> -->
                        </Input>
                        <Text
                            id="txtSolicCPInfo"
                            text="{local>/SolicInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- Row 3: 1 Input -->
                    <!-- DEST. MERCANCIA -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>DestMercancia}:"
                            labelFor="txtDestMercCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtDestMercCP"
                            value="{local>/DestMerc}"
                            submit="onPress($event, 'DestMerc')"
                            change=".onEvaluarPos"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeDestMerc"
                            showSuggestion="true"
                            suggest="onSuggest($event, 'DESTMERCANCIA')"
                            suggestionItems="{oDataMCDestMerc>/creapedi_destinatarios_nav/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'DESTMERCANCIA')"
                            maxSuggestionWidth="500px"
                            startSuggestion="0"
                            valueStateText="{i18n>ValorInvalido}"
                            editable="{local>/editable/DestMerc}"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCDestMerc>Kunnr}"
                                    text="{oDataMCDestMerc>Kunnr}"
                                    additionalText="{oDataMCDestMerc>Name1}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            id="txtDestMercCPInfo"
                            text="{local>/DestMercInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- Row 4: 1 Input -->
                    <!-- NRO. PEDIDO CLIENTE -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OCCliente}:"
                            labelFor="txtNroPedClienteCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtNroPedClienteCP"
                            value="{local>/NroPedCliente}"
                            editable="{local>/editable/NroPedCliente}"
                            width="6rem"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- Row 5: 1 Input -->
                    <!-- TRANSPORTISTA -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Transportista}:"
                            labelFor="txtTranspCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtTranspCP"
                            value="{local>/Transportista}"
                            submit="onPress($event, 'Transportista')"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeTransportista"
                            showSuggestion="true"
                            suggest="onSuggest($event, 'TRANSPORTISTA')"
                            suggestionItems="{oDataMCTransportista>/creapedi_transportistas_nav/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'TRANSPORTISTA')"
                            maxSuggestionWidth="500px"
                            startSuggestion="0"
                            valueStateText="{i18n>ValorInvalido}"
                            editable="{local>/editable/Transp}"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCTransportista>Lifnr}"
                                    text="{oDataMCTransportista>Lifnr}"
                                    additionalText="{oDataMCTransportista>Name1}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            id="txtTranspCPInfo"
                            text="{local>/TranspInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- Row 6: 4 Inputs -->
                    <!-- OFICINA -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>Oficina}:"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OfiVentasInfo}"
                            tooltip="{local>/OfiVentasInfo}"
                            editable="false"
                        />
                        <!-- <Text
                            text="{local>/OfiVentasInfo}"
                            class="sapUiTinyMargin"
                            wrapping="false"
                        /> -->
                        <layoutData>
                            <l:GridData span="XL3 L3 M3 S12" />
                        </layoutData>
                    </HBox>
                    <!-- GRUPO VEND. -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>GpoVend}:"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/GrupoVendInfo}"
                            tooltip="{local>/GrupoVendInfo}"
                            editable="false"
                        />
                        <!-- <Text
                            text="{local>/GrupoVendInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        /> -->
                        <layoutData>
                            <l:GridData span="XL3 L3 M3 S12" />
                        </layoutData>
                    </HBox>
                    <!-- COMERCIAL -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>Comercial}:"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Comercial}"
                            tooltip="{local>/Comercial}"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL3 L3 M3 S12" />
                        </layoutData>
                    </HBox>
                    <!-- LISTA DE PRECIOS -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>ListaPrecios}:"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/ListaPreciosInfo}"
                            tooltip="{local>/ListaPreciosInfo}"
                            editable="false"
                        />
                        <!-- <Text
                            text="{local>/ListaPreciosInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        /> -->
                        <layoutData>
                            <l:GridData span="XL3 L3 M3 S12" />
                        </layoutData>
                    </HBox>
                    <!-- Row 7: 2 RadioButton 1 checkbox -->
                    <!-- MONEDA -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>Moneda}:"
                            labelFor="rbtnMonedaCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <RadioButtonGroup
                            id="rbtnMonedaCP"
                            valueState="Information"
                            columns="2"
                            editable="false"
                        >
                            <RadioButton text="{i18n>Soles}" />
                            <RadioButton text="{i18n>Dolares}" />
                        </RadioButtonGroup>
                        <layoutData>
                            <l:GridData span="XL4 L4 M4 S12" />
                        </layoutData>
                    </HBox>
                    <!-- CLASE DOC. -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>ClaseDoc}:"
                            labelFor="rbtnClaseDocCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <RadioButtonGroup
                            id="rbtnClaseDocCP"
                            valueState="Information"
                            columns="2"
                            editable="false"
                        >
                            <RadioButton 
                                text="{i18n>Boleta}" 
                                visible="{= ${local>/Sociedad} === '1000' ? true : false }"
                            />
                            <RadioButton text="{i18n>Factura}" />
                        </RadioButtonGroup>
                        <layoutData>
                            <l:GridData span="XL4 L4 M4 S12" />
                        </layoutData>
                    </HBox>
                    <!-- CHECK ASUME FLETE -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            labelFor="chkFleteCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <CheckBox
                            id="chkFleteCP"
                            text="{local>/LblAsumeFlete}"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M4 S12" />
                        </layoutData>
                    </HBox>
                    <!-- COND. PAGO -->
                    <HBox
                        class="sapUiContentPadding"
                        alignItems="Center"
                    >
                        <Label
                            text="{i18n>CondPago}:"
                            labelFor="txtCondPagoCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <HBox>
                            <Input
                                id="txtCondPagoCP"
                                value="{local>/CondPago}"
                                editable="false"
                                width="4rem"
                            />
                            <Button
                                icon="sap-icon://value-help"
                                press=".onMatchcodeCondPago"
                                class="btnRefreshUser btnIconLaunchpad borderBtnRefresh"
                            />
                        </HBox>
                        <Text
                            id="txtCondPagoCPInfo"
                            text="{local>/CondPagoInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- CALCULAR PLAZO -->
                    <HBox
                        alignItems="Center"
                        class="sapUiContentPadding"
                    >
                        <Button
                            type="Success"
                            icon="sap-icon://simulate"
                            text="{i18n>CalcularPlazo}"
                            press="onCalcularPlazo"
                            width="12rem"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- OBS GUIA -->
                    <HBox
                        alignItems="Center"
                        class="sapUiContentPadding"
                    >
                        <Label
                            text="{i18n>ObservGuia}:"
                            labelFor="txtObsGuiaCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtObsGuiaCP"
                            value="{local>/ObsGuia}"
                            editable="{local>/editable/ObsGuia}"
                            width="25rem"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- OBS FACTURA -->
                    <HBox
                        alignItems="Center"
                        class="sapUiContentPadding"
                    >
                        <Label
                            text="{i18n>ObservFactura}:"
                            labelFor="txtObsFacturaCP"
                            textAlign="End"
                            width="110px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            id="txtObsFacturaCP"
                            value="{local>/ObsFactura}"
                            editable="false"
                            width="25rem"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <HBox
                        alignItems="Start"
                        alignContent="Center"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                    >
                        <Button
                            type="Success"
                            icon="sap-icon://clear-all"
                            text="{i18n>Limpiar}"
                            press="onLimpiarCampos"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            id="btnCrearPedido"
                            type="Success"
                            icon="sap-icon://create"
                            text="{i18n>CrearPedido}"
                            press="onCrearPedido"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            id="btnBorrarProdCP"
                            type="Success"
                            icon="sap-icon://sys-minus"
                            text="{i18n>BorrarProd}"
                            press="onPressBorrarProducto"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblCrearPedidos"
                rowActionCount="1"
                rows="{local>/PosPedidos/Tabla}"
                selectionMode="Single"
                enableBusyIndicator="true"
                showNoData="false"
                rowSelectionChange="onRowSelectionChange"
                class="sapUiTinyMarginTop sapUiTinyMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="4rem"
                        visible="false"
                    >
                        <Label text="{i18n>Pos}" />
                        <t:template>
                            <Input
                                value=""
                                editable="false"
                            />
                        </t:template>
                    </t:Column>
                    <!-- CENTRO -->
                    <t:Column width="6rem">
                        <!-- <Label text="{i18n>Centro}" /> -->
                        <Text text="{i18n>Centro}" width="100%" textAlign="Center" />
                        <t:template>
                            <ComboBox
                                id="cboCentroCP"
                                selectedKey="{local>Werks}"
                                selectionChange="onChangeCentro"
                                items="{
                                    path: 'local>Centros',
                                    sorter: { path: 'centro' }
                                }"
                                enabled="{local>itemActive}"
                            >
                                <core:Item
                                    key="{local>centro}"
                                    text="{local>centro}"
                                />
                            </ComboBox>
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="5rem"
                        visible="false"
                    >
                        <!-- <Label text="{i18n>Centro}" /> -->
                        <Text text="{i18n>Centro}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{local>Werks}"
                                submit="onPressCantidad"
                                maxLength="4"
                            />
                        </t:template>
                    </t:Column>
                    <!-- ALMACEN -->
                    <t:Column width="5rem">
                        <!-- <Label text="{i18n>Almacen}" /> -->
                        <Text text="{i18n>Almacen}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{local>Lgort}"
                                maxLength="4"
                                enabled="{local>itemActive}"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <!-- MATERIAL -->
                    <t:Column width="10rem">
                        <!-- <Label text="{i18n>Material}" /> -->
                        <Text text="{i18n>Material}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                id="txtItemMaterialCP"
                                value="{local>Matnr}"
                                showValueHelp="true"
                                valueHelpRequest=".onMatchcodeMaterial"
                                submit="onPressMaterial"
                                change="onPressMaterial"
                                enabled="{local>itemActive}"
                                editable="{local>PosBonif}"
                            />
                        </t:template>
                    </t:Column>
                    <!-- DENOMINACION -->
                    <t:Column width="25rem">
                        <!-- <Label text="{i18n>Denominacion}" /> -->
                        <Text text="{i18n>Denominacion}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{local>Maktx}"
                                enabled="{local>itemActive}"
                            />
                        </t:template>
                    </t:Column>
                    <!-- STOCK DISP. -->
                    <t:Column
                        width="7rem"
                    >
                        <!-- <Label text="{i18n>StockDisp}" /> -->
                        <Text text="{i18n>StockDisp}" width="100%" textAlign="Center" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'local>Labst',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.',
                                        groupingEnabled: true
                                    },
                                    constraints: {
                                        precision: 11,
                                        scale: 2
                                    }
                                }"
                                width="100%"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <!-- UM -->
                    <t:Column width="4rem">
                        <!-- <Label text="{i18n>UM}" /> -->
                        <Text text="{i18n>UM}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{local>Vrkme}"
                                enabled="{local>itemActive}"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <!-- CANTIDAD -->
                    <t:Column
                        width="6rem"
                    >
                        <!-- <Label text="{i18n>Cantidad}" /> -->
                        <Text text="{i18n>Cantidad}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{local>Zmeng}"
                                liveChange="onLiveChange($event,'ZMENG')"
                                submit="onPressCantidad2($event,'ZMENG')"
                                change="onPressCantidad1($event,'ZMENG')"
                                enabled="{local>itemActive1}"
                                editable="{local>PosBonif}"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <!-- PRECIO LISTA -->
                    <t:Column
                        width="6rem"
                    >
                        <!-- <Label text="{i18n>PrecioLista}" /> -->
                        <Text text="{i18n>PrecioLista}" width="100%" textAlign="Center" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'local>Precio',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.',
                                        groupingEnabled: true
                                    },
                                    constraints: {
                                        precision: 11,
                                        scale: 2
                                    }
                                }"
                                width="100%"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <!-- % DESCUENTO -->
                    <!-- <t:Column
                        width="6rem"
                        hAlign="End"
                    >
                        <Label text="{i18n>DescPorc}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'local>Desc',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.',
                                        groupingEnabled: true
                                    },
                                    constraints: {
                                        precision: 11,
                                        scale: 2
                                    }
                                }"
                            />
                        </t:template>
                    </t:Column> -->
                    <!-- PRECIO CON DESCUENTO -->
                    <t:Column width="6rem">
                        <!-- <Label text="{i18n>PrecioDesc}" /> -->
                        <!-- <Label text="{i18n>PrecioFinal}" /> -->
                        <Text text="{i18n>PrecioFinal}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{
                                    path: 'local>PrecioDesc',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.',
                                        groupingEnabled: true
                                    },
                                    constraints: {
                                        precision: 11,
                                        scale: 2
                                    }
                                }"
