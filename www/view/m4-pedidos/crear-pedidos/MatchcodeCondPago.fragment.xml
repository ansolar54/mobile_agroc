<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>CondPago1}"
        liveChange=".matchcodeSearch($event, 'dialogCondPagoCP')"
        confirm=".onConfirmPress($event, 'dialogCondPagoCP')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCCondPago>/creapedi_condpago_nav/results',
			sorter : {
				path : 'Zterm',
				descending : false
			}
		}"
        contentWidth="50%"
        contentHeight="50%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCCondPago>Zterm}" />
                <Text text="{oDataMCCondPago>Vtext}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column width="12em">
                <header>
                    <Text text="{i18n>CondPago}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
            >
                <header>
                    <Text text="{i18n>NombreCond}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
