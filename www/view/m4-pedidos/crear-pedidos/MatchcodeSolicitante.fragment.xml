    <Dialog
        id="dialogSolicitanteCP"
        title="{i18n>Solicitante}"
        contentHeight="70%"
        contentWidth="80%"
        draggable="true"
    >
        <content>
            <l:Grid class="sapUiTinyMargin">
                <l:content>
                    <VBox class="sapUiTinyMarginBottom">
                        <Label
                            text="{i18n>Cliente}:"
                            textAlign="Begin"
                        />
                        <Input
                            value="{local>/mcSolicitante/Cliente}"
                            submit="onBuscarSolicitante"
                        />
                        <layoutData>
                            <l:GridData span="XL3 L3 M3 S12" />
                        </layoutData>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                        <Label
                            text="{i18n>NombreCliente}:"
                            textAlign="Begin"
                        />
                        <Input
                            value="{local>/mcSolicitante/NombreCliente}"
                            submit="onBuscarSolicitante"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                        <Label
                            text="{i18n>RUC1}:"
                            textAlign="Begin"
                        />
                        <Input
                            value="{local>/mcSolicitante/RUC}"
                            submit="onBuscarSolicitante"
                        />
                        <layoutData>
                            <l:GridData span="XL3 L3 M3 S12" />
                        </layoutData>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                        <Button
                            type="Success"
                            icon="sap-icon://search"
                            text="{i18n>Buscar}"
                            press="onBuscarSolicitante"
                            width="100%"
                        >
                            <layoutData>
                                <FlexItemData growFactor="1" />
                            </layoutData>
                        </Button>
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S6" />
                        </layoutData>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                        <Button
                            type="Success"
                            icon="sap-icon://eraser"
                            text="{i18n>LimpiarCampos}"
                            press="onLimpiarSolicitante"
                            width="100%"
                        >
                            <layoutData>
                                <FlexItemData growFactor="1" />
                            </layoutData>
                        </Button>
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S6" />
                        </layoutData>
                    </VBox>
                </l:content>
            </l:Grid>
            <Table
                noDataText="{i18n>NoDataFound}"
                items="{
                path : 'oDataMCSolicitante>/creapedi_solicitantes_nav/results',
                sorter : {
                    path : 'Kunnr',
                    descending : false
                }
            }"
                enableBusyIndicator="true"
                mode="SingleSelectMaster"
                selectionChange=".onConfirmPress($event, 'dialogSolicitanteCP')"
                includeItemInSelection="false"
                modeAnimationOn="false"
                inset="false"
                growing="true"
            >
                <columns>
                    <Column hAlign="Center" >
                        <Text text="{i18n>Cliente}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                        width="30em"
                    >
                        <Text text="{i18n>NombreCliente}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                    >
                        <Text text="{i18n>ZonaCliente}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                    >
                        <Text text="{i18n>RUC1}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                        width="8em"
                    >
                        <Text text="{i18n>OrgVentas}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                        width="8em"
                    >
                        <Text text="{i18n>CanalVentas}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                        width="8em"
                    >
                        <Text text="{i18n>Sector}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                        visible="false"
                    >
                        <Text text="{i18n>SectorDesc}" />
                    </Column>
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        hAlign="Center"
                        visible="false"
                    >
                        <Text text="{i18n>CanalVentas1}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{oDataMCSolicitante>Kunnr}" />
                            <Text text="{oDataMCSolicitante>Name1}" class="customTextLeft" />
                            <Text text="{oDataMCSolicitante>Zona}" class="customTextLeft" />
                            <Text text="{oDataMCSolicitante>Stcd1}" />
                            <Text text="{oDataMCSolicitante>Vkorg}" />
                            <Text text="{oDataMCSolicitante>Vtweg}" />
                            <Text text="{oDataMCSolicitante>Spart}" />
                            <Text text="{oDataMCSolicitante>Sparttxt}" />
                            <Text text="{oDataMCSolicitante>Vtext}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button
                type="Default"
                icon="sap-icon://decline"
                text="{i18n>Cancelar}"
                press=".onCancelPress($event, 'dialogSolicitanteCP')"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>