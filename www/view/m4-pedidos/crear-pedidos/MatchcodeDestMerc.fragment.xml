<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>Destinatarios}"
        liveChange=".matchcodeSearch($event, 'dialogDestMercCP')"
        confirm=".onConfirmPress($event, 'dialogDestMercCP')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCDestMerc>/creapedi_destinatarios_nav/results',
			sorter : {
				path : 'Kunnr',
				descending : false
			}
		}"
        contentWidth=""
        contentHeight=""
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCDestMerc>Kunnr}" />
                <Text text="{oDataMCDestMerc>Name1}" class="customTextLeft" />
                <Text text="{oDataMCDestMerc>Direccion}" />
                <Text text="{oDataMCDestMerc>Zona}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column width="8rem" hAlign="Center" >
                <header>
                    <Text text="{i18n>Codigo}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Nombre}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Direccion}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Zona}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
