<core:FragmentDefinition
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
>
    <ValueHelpDialog
        id="dialogMultiClienteCO"
        title="{i18n>Clientes}"
        ok=".onOkPress($event, 'dialogMultiClienteCO')"
        cancel=".onCancelPress($event, 'dialogMultiClienteCO')"
        afterClose=".onAfterClose($event, 'dialogMultiClienteCO')"
        supportRanges="true"
        supportRangesOnly="true"
        key="Kunnr"
        descriptionKey="Denominacion"
        draggable="true"
    />
</core:FragmentDefinition>
