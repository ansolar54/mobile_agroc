<core:FragmentDefinition
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
>
    <ValueHelpDialog
        id="dialogMultiNroPedidoCO"
        title="{i18n>NroPedido}"
        ok=".onOkPress($event, 'dialogMultiNroPedidoCO')"
        cancel=".onCancelPress($event, 'dialogMultiNroPedidoCO')"
        afterClose=".onAfterClose($event, 'dialogMultiNroPedidoCO')"
        supportRanges="true"
        supportRangesOnly="true"
        key="Clave"
        descriptionKey="Denominacion"
        draggable="true"
    />
</core:FragmentDefinition>
