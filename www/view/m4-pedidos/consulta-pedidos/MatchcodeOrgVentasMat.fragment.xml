<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>OrgVentas} - {i18n>Materiales}"
        liveChange=".handleSearchLiveChange($event, 'dialogOrgVentasMatCO')"
        confirm=".onConfirmPress($event, 'dialogOrgVentasMatCO')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCOrgVentas>/results',
			sorter : {
				path : 'Vkorg',
				descending : false
			}
		}"
        contentWidth="30%"
        contentHeight="60%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCOrgVentas>Vkorg}" />
                <Text text="{oDataMCOrgVentas>Vtext}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column hAlign="Center" width="12em" >
                <header>
                    <Text text="{i18n>OrgVentas}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Denominacion}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
