<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogCalcPlazoMP"
        title="{i18n>CalcularPlazo}"
        contentHeight="50%"
        contentWidth="{=${local>/IsMobile} ? '40%' : '50%'}"
        draggable="true"
    >
        <content>
            <!-- WEB -->
            <l:Grid class="sapUiTinyMarginTop sapUiTinyMarginBottom"  visible="{=!${local>/IsMobile}}">
                <l:content>
                    <!-- FECHA EMISIÓN -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>FechaEmision}"
                            textAlign="End"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <DatePicker
                            placeholder="{i18n>FormatoFecha1}"
                            width="8rem"
                            value="{
                                'path': 'local>/CalcularPlazo/FechaEmision',
                                'type': 'sap.ui.model.type.Date',
                                'formatOptions': {
                                    'pattern': 'dd/MM/y'
                                }
                            }"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- NRO LETRAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>NCuotas}"
                            textAlign="End"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/CalcularPlazo/NroLetras}"
                            liveChange="onLiveChange($event,'NROLETRAS')"
                            submit=".onNroLetrasEnter"
                            width="5rem"
                            textAlign="End"
                            editable="{local>/CalcularPlazo/NroLetrasEditable}"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- MONEDA -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Moneda}"
                            textAlign="End"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/CalcularPlazo/Moneda}"
                            editable="false"
                            width="5rem"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </HBox>
                    <VBox>
                        <!-- TIPO DE CAMBIO -->
                        <HBox alignItems="Center">
                            <Label
                                text="{i18n>TipoCambio}"
                                textAlign="End"
                                width="120px"
                                class="sapUiTinyMargin"
                            />
                            <Input
                                value="{local>/CalcularPlazo/TipoCambio}"
                                textAlign="End"
                                editable="false"
                                width="7rem"
                            />
                            <layoutData>
                                <l:GridData span="XL6 L6 M12 S12" />
                            </layoutData>
                        </HBox>
                        <!-- IMPORTE TOTAL -->
                        <HBox alignItems="Center">
                            <Label
                                text="{i18n>ImporteTotal}"
                                textAlign="End"
                                width="120px"
                                class="sapUiTinyMargin"
                            />
                            <Input
                                value="{
                                    path: 'local>/CalcularPlazo/ImpTotal',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.',
                                        groupingEnabled: true
                                    },
                                    constraints: {
                                        precision: 11,
                                        scale: 2
                                    }
                                }"
                                textAlign="End"
                                editable="false"
                                width="7rem"
                            />
                            <layoutData>
                                <l:GridData span="XL12 L12 M12 S12" />
                            </layoutData>
                        </HBox>
                    </VBox>
                </l:content>
            </l:Grid>
            <!-- MOBILE -->
            <l:Grid class="sapUiTinyMarginTop sapUiTinyMarginBottom"  visible="{=${local>/IsMobile}}">
                <l:content>
                    <!-- FECHA EMISIÓN -->
                    <VBox>
                        <Label
                            text="{i18n>FechaEmision}"
                            textAlign="End"
                        />
                        <DatePicker
                            placeholder="{i18n>FormatoFecha1}"
                            value="{
                                'path': 'local>/CalcularPlazo/FechaEmision',
                                'type': 'sap.ui.model.type.Date',
                                'formatOptions': {
                                    'pattern': 'dd/MM/y'
                                }
                            }"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </VBox>
                    <!-- IMPORTE TOTAL -->
                    <VBox>
                        <Label
                            text="{i18n>ImporteTotal} {local>/CalcularPlazo/Moneda}"
                            textAlign="End"
                        />
                        <Input
                            value="{
                                path: 'local>/CalcularPlazo/ImpTotal',
                                type: 'sap.ui.model.type.Float',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2,
                                    groupingSeparator: ',',
                                    decimalSeparator: '.',
                                    groupingEnabled: true
                                },
                                constraints: {
                                    precision: 11,
                                    scale: 2
                                }
                            }"
                            textAlign="End"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </VBox>
                    <!-- MONEDA -->
                    <!-- <VBox>
                        <Label
                            text="{i18n>Moneda}"
                            textAlign="End"
                        />
                        <Input
                            value="{local>/CalcularPlazo/Moneda}"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </VBox> -->
                    <!-- NRO LETRAS - CUOTAS -->
                    <VBox>
                        <Label
                            text="{i18n>NCuotas}"
                            textAlign="End"
                        />
                        <Input
                            value="{local>/CalcularPlazo/NroLetras}"
                            liveChange="onLiveChange($event,'NROLETRAS')"
                            submit=".onNroLetrasEnter"
                            change=".onNroLetrasEnter"
                            textAlign="End"
                            editable="{local>/CalcularPlazo/NroLetrasEditable}"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </VBox>
                    <!-- TIPO DE CAMBIO -->
                    <!-- <VBox>
                        <Label
                            text="{i18n>TipoCambio}"
                            textAlign="End"
                        />
                        <Input
                            value="{local>/CalcularPlazo/TipoCambio}"
                            textAlign="End"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </VBox> -->
                </l:content>
            </l:Grid>
            <t:Table
                id="tblCalcularPlazoMP"
                rows="{local>/CalcularPlazo/Tabla}"
                rowActionCount="1"
                selectionMode="None"
                visibleRowCount="5"
                showNoData="false"
                class="sapUiTinyMargin"
            >
                <t:columns>
                    <t:Column width="{=${local>/IsMobile} ? '4rem' : '8rem'}">
                        <!-- <Text text="{i18n>NroDias}" width="100%" textAlign="Center" /> -->
                        <Text 
                            text="{
                                parts: [
                                    { path: 'local>/IsMobile' },
                                    { path: 'i18n>NroDias1' },
                                    { path: 'i18n>NroDias' }
                                ], 
                                formatter: '.formatter.formatearTextoi18n'
                            }" 
                            width="100%" 
                            textAlign="Center" 
                        />
                        <t:template>
                            <Input
                                type="Number"
                                value="{local>NroDias}"
                                submit=".onNroDiasSubmit"
                                change=".onNroDiasSubmit"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column width="{=${local>/IsMobile} ? '9rem' : ''}">
                        <!-- <Text text="{i18n>FechaVenc}" width="100%" textAlign="Center" /> -->
                        <Text 
                            text="{
                                parts: [
                                    { path: 'local>/IsMobile' },
                                    { path: 'i18n>FechaVenc1' },
                                    { path: 'i18n>FechaVenc' }
                                ], 
                                formatter: '.formatter.formatearTextoi18n'
                            }" 
                            width="100%" 
                            textAlign="Center" 
                        />
                        <t:template>
                            <DatePicker
                                displayFormat="dd.MM.yyyy"
                                dateValue="{local>FechaVenc}"
                                placeholder="dd.MM.yyyy"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column width="{=${local>/IsMobile} ? '4rem' : '8rem'}">
                        <Text text="{i18n>Importe}" width="100%" textAlign="Center" />
                        <t:template>
                            <Input
                                value="{
                                    path: 'local>Importe',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.',
                                        groupingEnabled: true
                                    },
                                    constraints: {
                                        precision: 11,
                                        scale: 2
                                    }
                                }"
                                textAlign="End"
                                editable="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </content>
        <beginButton>
            <Button
                text="{i18n>Cerrar}"
                type="Default"
                press=".onCancelPress($event, 'dialogCalcPlazoMP')"
                width="6rem"
            />
        </beginButton>
        <endButton>
            <Button
                type="Success"
                icon="sap-icon://accept"
                text="{i18n>Ok}"
                press=".onOkPress($event, 'dialogCalcPlazoMP')"
                width="6rem"
                class="sapUiTinyMarginEnd"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
