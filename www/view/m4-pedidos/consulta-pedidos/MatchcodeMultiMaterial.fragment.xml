<core:FragmentDefinition
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
>
    <ValueHelpDialog
        id="dialogMultiMaterialCO"
        title="{i18n>Materiales}"
        ok=".onOkPress($event, 'dialogMultiMaterialCO')"
        cancel=".onCancelPress($event, 'dialogMultiMaterialCO')"
        afterClose=".onAfterClose($event, 'dialogMultiMaterialCO')"
        supportRanges="true"
        supportRangesOnly="true"
        key="Matnr"
        descriptionKey="Denominacion"
        supportMultiselect="true"
        draggable="true"
    />
</core:FragmentDefinition>
