<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>Centro}"
        liveChange=".onMatchcodeSearch($event, 'dialogCentroCS')"
        confirm=".onConfirmPress($event, 'dialogCentroCS')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCCentro>/results',
			sorter : {
				path : 'Werks',
				descending : false
			}
		}"
        contentWidth="30%"
        contentHeight="50%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCCentro>Werks}" />
                <Text text="{oDataMCCentro>Name1}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column hAlign="Center" width="8em" >
                <header>
                    <Text text="{i18n>Centro}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Denominacion}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
