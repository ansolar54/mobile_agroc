<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>Lote}"
        liveChange=".onMatchcodeSearch($event, 'dialogLoteCS')"
        confirm=".onConfirmPress($event, 'dialogLoteCS')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCLote>/matcode_lotes_nav/results',
			sorter : {
				path : 'Charg',
				descending : false
			}
		}"
        contentWidth="30%"
        contentHeight="70%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <Text text="{oDataMCLote>Matnr}" />
                <Text text="{oDataMCLote>Werks}" />
                <ObjectIdentifier title="{oDataMCLote>Charg}" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column hAlign="Center" width="10em" >
                <header>
                    <Text text="{i18n>Material}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Tablet"
                demandPopin="true"
                hAlign="Center"
                width="8em"
            >
                <header>
                    <Text text="{i18n>Centro}" />
                </header>
            </Column>
            <Column hAlign="Center" width="8em" >
                <header>
                    <Text text="{i18n>Lote}" />
                </header>
            </Column>
            <!-- <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Denominacion}" />
                </header>
            </Column> -->
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
