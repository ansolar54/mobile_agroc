<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m2-reportes.ConsultaStock"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <!-- WEB -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderR02}"
        class="custBackgroundColor"
        visible="{=!${local>/IsMobile}}"
    >
        <content>
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <!-- CENTRO -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Centro}:"
                            textAlign="Begin"
                            width="110px"
                            class="sapUiTinyMarginEnd sapUiTinyMarginTopBottom"
                        />
                        <Input
                            value="{local>/Centro}"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeCentro"
                            liveChange="onChange($event, 'Centro')"
                            showClearIcon="true"
                            showSuggestion="true"
                            suggestionItems="{oDataMCCentro>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'CENTRO')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            maxLength="4"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCCentro>Werks}"
                                    text="{oDataMCCentro>Werks}"
                                    additionalText="{oDataMCCentro>Name1}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/CentroInfo}"
                            wrapping="false"
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- ALMACEN -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Almacen}:"
                            textAlign="Begin"
                            width="110px"
                            class="sapUiTinyMarginEnd sapUiTinyMarginTopBottom"
                        />
                        <Input
                            value="{local>/Almacen}"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeAlmacen"
                            showClearIcon="true"
                            width="8rem"
                            editable="false"
                        />
                        <Text
                            text="{local>/AlmacenInfo}"
                            wrapping="false"
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- ORG. VENTAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OrgVentas}:"
                            textAlign="Begin"
                            width="110px"
                            class="sapUiTinyMarginEnd sapUiTinyMarginTopBottom"
                        />
                        <Input
                            value="{local>/OrgVentas}"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeOrgVentas"
                            liveChange="onChange($event, 'OrgVentas')"
                            showClearIcon="true"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOrgVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            maxLength="4"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                    text="{oDataMCOrgVentas>Vkorg}"
                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/OrgVentasInfo}"
                            wrapping="false"
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- SECTOR -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Sector}:"
                            textAlign="Begin"
                            width="110px"
                            class="sapUiTinyMarginEnd sapUiTinyMarginTopBottom"
                        />
                        <Input
                            value="{local>/Sector}"
                            showClearIcon="true"
                            width="8rem"
                            editable="false"
                        />
                        <Text
                            text="{local>/SectorInfo}"
                            wrapping="false"
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- MATERIAL -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Material}:"
                            textAlign="Begin"
                            width="110px"
                            class="sapUiTinyMarginEnd sapUiTinyMarginTopBottom"
                        />
                        <Input
                            value="{local>/Material}"
                            submit=".onPress($event, 'MATERIAL')"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeMaterial"
                            showClearIcon="true"
                            width="10rem"
                        />
                        <Text
                            text="{local>/MaterialInfo}"
                            wrapping="false"
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- LOTE -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Lote}:"
                            textAlign="Begin"
                            width="110px"
                            class="sapUiTinyMarginEnd sapUiTinyMarginTopBottom"
                        />
                        <Input
                            value="{local>/Lote}"
                            liveChange="onChange($event, 'Lote')"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeLote"
                            width="8rem"
                        />
                        <Text
                            text="{local>/LoteInfo}"
                            wrapping="false"
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- BOTONES -->
                    <HBox
                        alignItems="Start"
                        alignContent="Center"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                    >
                        <Button
                            id="btnBuscarCS"
                            type="Success"
                            icon="sap-icon://search"
                            text="{i18n>Buscar}"
                            press="onBuscar"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />

                        <Button
                            type="Success"
                            icon="sap-icon://clear-all"
                            text="{i18n>LimpiarCampos}"
                            press=".onLimpiarCampos"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            id="btnDescargarCS"
                            type="Success"
                            icon="sap-icon://excel-attachment"
                            text="{i18n>DescargarExcel}"
                            press=".onMatchcodeDescargar"
                            width="12rem"
                            enabled="{local>/Excel/BtnEnabled}"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblConsultaStock"
                rowActionCount="1"
                rows="{oDataCStock>/reporte_consultastock_nav/results}"
                enableSelectAll="true"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                sort="onTableSort"
                filter="onTableFilter"
                class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty="Werks"
                        filterProperty="Werks"
                        filterValue="{local>/filters/Werks}"
                    >
                        <!-- <Label text="{i18n>Centro}" /> -->
                        <Text
                            text="{i18n>Centro}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataCStock>Werks} ({oDataCStock>Werkstxt})"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Matnr"
                        filterProperty="Matnr"
                        filterValue="{local>/filters/Matnr}"
                    >
                        <!-- <Label text="{i18n>Material}" /> -->
                        <Text
                            text="{i18n>Material}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataCStock>Matnr}"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="30rem"
                        showSortMenuEntry="true"
                        sortProperty="Maktx"
                        filterProperty="Maktx"
                        filterValue="{local>/filters/Maktx}"
                    >
                        <!-- <Label text="{i18n>MaterialTextoBreve}" /> -->
                        <Text
                            text="{i18n>MaterialTextoBreve}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataCStock>Maktx}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <!-- EMPAQUE -->
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Empaque"
                        filterProperty="Empaque"
                        filterValue="{local>/filters/Empaque}"
                    >
                        <Text
                            text="{i18n>Empaque}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{ path: 'oDataCStock>Empaque',
                                        formatter : '.formatter.formatNumberInt' }"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <!--  -->
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Labst"
                        filterProperty="Labst"
                        filterValue="{local>/filters/Labst}"
                    >
                        <!-- <Label text="{i18n>LibreUtiliz}" /> -->
                        <Text
                            text="{i18n>LibreUtiliz}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{ path: 'oDataCStock>Labst',
                                        formatter : '.formatter.formatNumberInt' }"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Clabs"
                        filterProperty="Clabs"
                        filterValue="{local>/filters/Clabs}"
                    >
                        <!-- <Label text="{i18n>StockLote}" /> -->
                        <Text
                            text="{i18n>StockLote}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{ path: 'oDataCStock>Clabs',
                                    formatter : '.formatter.formatNumberInt' }"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="4rem"
                        showSortMenuEntry="true"
                        sortProperty="Meins"
                        filterProperty="Meins"
                        filterValue="{local>/filters/Meins}"
                    >
                        <!-- <Label text="{i18n>UMB}" /> -->
                        <Text
                            text="{i18n>UMB}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataCStock>Meins}"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="5rem"
                        showSortMenuEntry="true"
                        sortProperty="Charg"
                        filterProperty="Charg"
                        filterValue="{local>/filters/Charg}"
                    >
                        <!-- <Label text="{i18n>Lote}" /> -->
                        <Text
                            text="{i18n>Lote}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataCStock>Charg}"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Fvenc"
                        filterProperty="Fvenc"
                        filterValue="{local>/filters/Fvenc}"
                    >
                        <!-- <Label text="{i18n>FechaVenc}" /> -->
                        <Text
                            text="{i18n>FechaVenc}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{
                                    path: 'oDataCStock>Fvenc',
                                    formatter : '.formatter.fecha' 
                                }"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Mtart"
                        filterProperty="Mtart"
                        filterValue="{local>/filters/Mtart}"
                    >
                        <!-- <Label text="{i18n>TP-MT}" /> -->
                        <Text
                            text="{i18n>TP-MT}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataCStock>Mtart}"
                                wrapping="false"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>

    <!-- MOBILE -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderR02}"
        class="custBackgroundColor"
        visible="{=${local>/IsMobile}}"
    >
        <content>
            <VBox>
                <f:Form editable="true">
                    <!-- <f:title>
                        <core:Title text="{i18n>HeaderR02}" />
                    </f:title> -->
                    <f:layout>
                        <f:ColumnLayout
                            columnsM="2"
                            columnsL="2"
                            columnsXL="2"
                        />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <!-- CENTRO -->
                                <f:FormElement label="{i18n>Centro}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Centro}"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeCentro"
                                            liveChange="onChange($event, 'Centro')"
                                            showClearIcon="true"
                                            showSuggestion="true"
                                            suggestionItems="{oDataMCCentro>/results}"
                                            suggestionItemSelected="onSuggeItemSelected($event, 'CENTRO')"
                                            maxSuggestionWidth="350px"
                                            startSuggestion="0"
                                            maxLength="4"
                                        >
                                            <suggestionItems>
                                                <core:ListItem
                                                    key="{oDataMCCentro>Werks}"
                                                    text="{oDataMCCentro>Werks}"
                                                    additionalText="{oDataMCCentro>Name1}"
                                                />
                                            </suggestionItems>
                                        </Input>
                                        <Text
                                            text="{local>/CentroInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- ALMACEN -->
                                <f:FormElement label="{i18n>Almacen}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Almacen}"
                                            showClearIcon="true"
                                            valueHelpRequest=".onMatchcodeAlmacen"
                                            showValueHelp="true"
                                            editable="false"
                                        />
                                        <Text
                                            text="{local>/AlmacenInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- ORG. VENTAS -->
                                <f:FormElement label="{i18n>OrgVentas}">
                                    <f:fields>
                                        <Input
                                            value="{local>/OrgVentas}"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeOrgVentas"
                                            liveChange="onChange($event, 'OrgVentas')"
                                            showClearIcon="true"
                                            showSuggestion="true"
                                            suggestionItems="{oDataMCOrgVentas>/results}"
                                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                                            maxSuggestionWidth="350px"
                                            startSuggestion="0"
                                            maxLength="4"
                                        >
                                            <suggestionItems>
                                                <core:ListItem
                                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                                    text="{oDataMCOrgVentas>Vkorg}"
                                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                                />
                                            </suggestionItems>
                                        </Input>
                                        <Text
                                            text="{local>/OrgVentasInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- SECTOR -->
                                <f:FormElement label="{i18n>Sector}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Sector}"
                                            showClearIcon="true"
                                            editable="false"
                                        />
                                        <Text
                                            text="{local>/SectorInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- MATERIAL -->
                                <f:FormElement label="{i18n>Material}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Material}"
                                            submit=".onPress($event, 'MATERIAL')"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeMaterial"
                                            showClearIcon="true"
                                        />
                                        <Text
                                            text="{local>/MaterialInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- LOTE -->
                                <f:FormElement label="{i18n>Lote}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Lote}"
                                            liveChange="onChange($event, 'Lote')"
                                            showClearIcon="true"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeLote"
                                        />
                                        <Text
                                            text="{local>/LoteInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
                <!-- BOTONES -->
                <l:Grid class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                    <l:content>
                        <HBox>
                            <items>
                                <Button
                                    id="btnBuscarCSMob"
                                    type="Success"
                                    icon="sap-icon://search"
                                    text="{i18n>Buscar}"
                                    width="9rem"
                                    press="onBuscar"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    type="Success"
                                    icon="sap-icon://clear-all"
                                    text="{i18n>LimpiarCampos}"
                                    press=".onLimpiarCampos"
                                    class="sapUiTinyMarginEnd"
                                />
                            </items>
                            <layoutData>
                                <l:GridData span="XL12 L12 M12 S12" />
                            </layoutData>
                        </HBox>
                    </l:content>
                </l:Grid>
                <!-- TABLA -->
                <t:Table
                    id="tblConsultaStockMob"
                    rowActionCount="1"
                    rows="{oDataCStock>/reporte_consultastock_nav/results}"
                    enableSelectAll="false"
                    enableBusyIndicator="true"
                    busy="{local>/loadingTbl}"
                    sort="onTableSort"
                    filter="onTableFilter"
                    class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
                >
                    <t:columns>
                        <!-- <t:Column
                    width="12rem"
                    showSortMenuEntry="true"
                    sortProperty="Werks"
                    filterProperty="Werks"
                    filterValue="{local>/filters/Werks}"
                    hAlign="Left"
                >
                    <Label text="{i18n>Centro}" />
                    <t:template>
                        <Text
                            text="{oDataCStock>Werks} ({oDataCStock>Werkstxt})"
                            wrapping="false"
                        />
                    </t:template>
                </t:Column> -->
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Matnr"
                            filterProperty="Matnr"
                            filterValue="{local>/filters/Matnr}"
                            hAlign="Center"
                        >
                            <!-- <Label text="{i18n>Material}" /> -->
                            <Text
                                text="{i18n>Material}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{oDataCStock>Matnr}"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="20rem"
                            showSortMenuEntry="true"
                            sortProperty="Maktx"
                            filterProperty="Maktx"
                            filterValue="{local>/filters/Maktx}"
                        >
                            <!-- <Label text="{i18n>MaterialTextoBreve}" /> -->
                            <Text
                                text="{i18n>MaterialTextoBreve}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{oDataCStock>Maktx}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <!-- EMPAQUE -->
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Empaque"
                            filterProperty="Empaque"
                            filterValue="{local>/filters/Empaque}"
                        >
                            <Text
                                text="{i18n>Empaque}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{ path: 'oDataCStock>Empaque',
                                            formatter : '.formatter.formatNumberInt' }"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <!--  -->
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Labst"
                            filterProperty="Labst"
                            filterValue="{local>/filters/Labst}"
                        >
                            <!-- <Label text="{i18n>LibreUtiliz}" /> -->
                            <Text
                                text="{i18n>LibreUtiliz}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{ path: 'oDataCStock>Labst',
                                            formatter : '.formatter.formatNumberInt' }"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Clabs"
                            filterProperty="Clabs"
                            filterValue="{local>/filters/Clabs}"
                        >
                            <!-- <Label text="{i18n>StockLote}" /> -->
                            <Text
                                text="{i18n>StockLote}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{ path: 'oDataCStock>Clabs',
                                formatter : '.formatter.formatNumberInt' }"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="3rem"
                            showSortMenuEntry="true"
                            sortProperty="Meins"
                            filterProperty="Meins"
                            filterValue="{local>/filters/Meins}"
                        >
                            <!-- <Label text="{i18n>UMB}" /> -->
                            <Text
                                text="{i18n>UMB}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{oDataCStock>Meins}"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="5rem"
                            showSortMenuEntry="true"
                            sortProperty="Charg"
                            filterProperty="Charg"
                            filterValue="{local>/filters/Charg}"
                        >
                            <!-- <Label text="{i18n>Lote}" /> -->
                            <Text
                                text="{i18n>Lote}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{oDataCStock>Charg}"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Fvenc"
                            filterProperty="Fvenc"
                            filterValue="{local>/filters/Fvenc}"
                        >
                            <!-- <Label text="{i18n>FechaVenc}" /> -->
                            <!-- <Label text="Fecha Venc." /> -->
                            <Text
                                text="Fecha Venc."
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{
                                path: 'oDataCStock>Fvenc',
                                formatter : '.formatter.fecha' 
                            }"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="4rem"
                            showSortMenuEntry="true"
                            sortProperty="Mtart"
                            filterProperty="Mtart"
                            filterValue="{local>/filters/Mtart}"
                        >
                            <!-- <Label text="{i18n>TP-MT}" /> -->
                            <Text
                                text="{i18n>TP-MT}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{oDataCStock>Mtart}"
                                    wrapping="false"
                                    width="100%"
                                    textAlign="Center"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
                <!-- PAGINACION -->
                <l:Grid class="sapUiTinyMarginTop">
                    <l:content>
                        <HBox>
                            <Button
                                type="Emphasized"
                                icon="sap-icon://close-command-field"
                                press="onFirstPress"
                                enabled="{local>/page/PrevPageBtn}"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://navigation-left-arrow"
                                press="onPreviousPress"
                                enabled="{local>/page/PrevPageBtn}"
                            />
                            <Text
                                text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                                textAlign="Center"
                                width="120px"
                                class="sapUiTinyMargin"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://navigation-right-arrow"
                                press="onNextPress"
                                enabled="{local>/page/NextPageBtn}"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://open-command-field"
                                press="onLastPress"
                                enabled="{local>/page/NextPageBtn}"
                            />
                        </HBox>
                    </l:content>
                </l:Grid>
            </VBox>
        </content>
    </Panel>
</mvc:View>
