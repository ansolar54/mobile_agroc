<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m2-reportes.PromocionesPrecioPorVol"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderR08}"
        class="custBackgroundColor"
        visible="{=!${local>/IsMobile}}"
    >
        <content>
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <!-- OFICINA VENTAS -->
                    <HBox>
                        <Label
                            text="{i18n>OfiVentas1}"
                            textAlign="Initial"
                            required="true"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OfiVentas}"
                            liveChange="onChange($event, 'OfiVentas')"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest="onMatchcodeOfiVentas"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOfiVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'OFIVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOfiVentas>Vkbur}"
                                    text="{oDataMCOfiVentas>Vkbur}"
                                    additionalText="{oDataMCOfiVentas>Bezei}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/OfiVentasInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- LISTA DE PRECIOS -->
                    <HBox>
                        <Label
                            text="{i18n>ListaPrecios2}"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                            required="true"
                        />
                        <Input
                            value="{local>/ListaPrecio}"
                            liveChange="onChange($event, 'ListaPrecio')"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest="onMatchcodeListaPrecio"
                            showSuggestion="true"
                            suggestionItems="{oDataMCListaPrecio>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'LISTAPRECIO')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCListaPrecio>Pltyp}"
                                    text="{oDataMCListaPrecio>Pltyp}"
                                    additionalText="{oDataMCListaPrecio>Ptext}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/ListaPrecioInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- ORG. VENTAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OrgVentas1}:"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OrgVentas}"
                            showValueHelp="true"
                            valueHelpRequest="onMatchcodeOrgVentas"
                            liveChange="onChange($event, 'OrgVentas')"
                            showClearIcon="true"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOrgVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            maxLength="4"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                    text="{oDataMCOrgVentas>Vkorg}"
                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                            wrapping="false"
                            text="{local>/OrgVentasInfo}"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- SECTOR -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Sector}:"
                            textAlign="Begin"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Sector}"
                            width="8rem"
                            editable="false"
                        />
                        <Text
                            text="{local>/SectorInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>


                    <!-- CANAL DISTRIBUCION -->
                    <!-- <HBox alignItems="Center">
                        <Label
                            text="{i18n>CanalDistrib2}:"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/CanalDist}"
                            editable="false"
                            width="8rem"
                        />
                        <Text
                            text="{local>/CanalDistInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox> -->
                    <!-- VALIDO EL -->
                    <!-- <HBox alignItems="Center">
                        <Label
                            text="{i18n>ValidoEl}:"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <DatePicker
                            required="true"
                            placeholder="{i18n>FormatoFecha1}"
                            width="8rem"
                            value="{
                                    'path': 'local>/ValidoEl',
                                    'type': 'sap.ui.model.type.Date',
                                    'formatOptions': {
                                        'pattern': 'dd/MM/yyyy'
                                        }
                                    }"
                            class="sapUiTinyMarginEnd"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox> -->
                    <!-- BOTONES BUSCAR - LIMPIAR - DESCARGAR PDF -->
                    <HBox
                        alignItems="Start"
                        alignContent="Center"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                    >
                        <Button
                            id="btnBuscarPPV"
                            type="Success"
                            icon="sap-icon://search"
                            text="{i18n>Buscar}"
                            press=".onBuscar"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            id="btnLimpiarPPV"
                            type="Success"
                            icon="sap-icon://clear-all"
                            text="{i18n>LimpiarCampos}"
                            press=".onLimpiarCampos"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            id="btnDescargarPDFPPV"
                            type="Success"
                            icon="sap-icon://pdf-attachment"
                            text="{i18n>DescargarPDF}"
                            press=".onDescargarPDF"
                            width="12rem"
                            visible="{local>/Descarga}"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblPromPrecioPorVol"
                rowActionCount="1"
                rows="{oDataPromPrecioPorVol>/reporte_promprecvol_nav/results}"
                selectionMode="Single"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                sort="onTableSort"
                filter="onTableFilter"
                class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Vkorg"
                        filterProperty="Vkorg"
                        filterValue="{local>/filters/Vkorg}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OrgVentas}" />
                        <t:template>
                            <Text
                                text="{oDataPromPrecioPorVol>Vkorg}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Spart"
                        filterProperty="Spart"
                        filterValue="{local>/filters/Spart}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Sector}" />
                        <t:template>
                            <Text
                                text="{oDataPromPrecioPorVol>Spart}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Matnr"
                        filterProperty="Matnr"
                        filterValue="{local>/filters/Matnr}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>MaterialCod}" />
                        <t:template>
                            <Text
                                text="{oDataPromPrecioPorVol>Matnr}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty="Maktx"
                        filterProperty="Maktx"
                        filterValue="{local>/filters/Maktx}"
                    >
                        <t:label>
                            <Label text="{i18n>Material}" textAlign="Center" width="100%" />
                        </t:label>
                        <t:template>
                            <Text
                                text="{oDataPromPrecioPorVol>Maktx}"
                                wrapping="false"
                                textAlign="Left"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="CantEscala"
                        filterProperty="CantEscala"
                        filterValue="{local>/filters/CantEscala}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>CantidadEscala}" />
                        <t:template>
                            <!-- <Text
                                text="{oDataPromPrecioPorVol>CantEscala}"
                                wrapping="false"
                            /> -->
                            <Text
                                text="{ 
                                    path: 'oDataPromPrecioPorVol>CantEscala',
                                    formatter : '.formatter.integer' 
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="ListaPrecio"
                        filterProperty="ListaPrecio"
                        filterValue="{local>/filters/ListaPrecio}"
                    >
                        <t:label>
                            <Label text="{i18n>PrecioEscala}" textAlign="Center" width="100%" />
                        </t:label>
                        <t:template>
                            <Text
                                text="{ 
                                    path: 'oDataPromPrecioPorVol>ListaPrecio',
                                    formatter : '.formatter.twodecimals' 
                                }"
                                wrapping="false"
                                textAlign="Right"
                                width="100%"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Waers"
                        filterProperty="Waers"
                        filterValue="{local>/filters/Waers}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Moneda}" />
                        <t:template>
                            <Text
                                text="{oDataPromPrecioPorVol>Waers}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        showSortMenuEntry="true"
                        sortProperty="Datab"
                        filterProperty="Datab"
                        filterValue="{local>/filters/Datab}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaInicio}" />
                        <t:template>
                            <Text
                                text="{ 
                                    path: 'oDataPromPrecioPorVol>Datab',
                                    formatter : '.formatter.fecha2' 
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        showSortMenuEntry="true"
                        sortProperty="Datbi"
                        filterProperty="Datbi"
                        filterValue="{local>/filters/Datbi}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaFin}" />
                        <t:template>
                            <Text
                                text="{ 
                                    path: 'oDataPromPrecioPorVol>Datbi',
                                    formatter : '.formatter.fecha2' 
                                }"
                                wrapping="false"
                            />
                            <!-- <Text
                                text="{oDataPromPrecioPorVol>Datbi}"
                                wrapping="false"
                            /> -->
                        </t:template>
                    </t:Column>
                    <!-- <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Pltyp"
                        filterProperty="Pltyp"
                        filterValue="{local>/filters/Pltyp}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>ListaPrecios2}" />
                        <t:template>
                            <Text
                                text="{oDataPromPrecioPorVol>Pltyp}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column> -->
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>

    <!-- MOBILE -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderR08}"
        class="custBackgroundColor"
        visible="{=${local>/IsMobile}}"
    >
        <content>
            <VBox>
                <f:Form editable="true">
                    <f:layout>
                        <f:ColumnLayout
                            columnsM="2"
                            columnsL="2"
                            columnsXL="2"
                        />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <!-- OFICINA VENTAS -->
                                <f:FormElement label="{i18n>OfiVentas1}">
                                    <f:fields>
                                        <Input
                                            value="{local>/OfiVentas}"
                                            liveChange="onChange($event, 'OfiVentas')"
                                            showClearIcon="true"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeOfiVentas"
                                            showSuggestion="true"
                                            suggestionItems="{oDataMCOfiVentas>/results}"
                                            suggestionItemSelected="onSuggeItemSelected($event, 'OFIVENTAS')"
                                            maxSuggestionWidth="350px"
                                            startSuggestion="0"
                                            width="8rem"
                                            required="true"
                                        >
                                            <suggestionItems>
                                                <core:ListItem
                                                    key="{oDataMCOfiVentas>Vkbur}"
                                                    text="{oDataMCOfiVentas>Vkbur}"
                                                    additionalText="{oDataMCOfiVentas>Bezei}"
                                                />
                                            </suggestionItems>
                                        </Input>
                                        <Text
                                            text="{local>/OfiVentasInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- LISTA DE PRECIOS -->
                                <f:FormElement label="{i18n>ListaPrecios2}">
                                    <f:fields>
                                        <Input
                                            value="{local>/ListaPrecio}"
                                            liveChange="onChange($event, 'ListaPrecio')"
                                            showClearIcon="true"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeListaPrecio"
                                            showSuggestion="true"
                                            suggestionItems="{oDataMCListaPrecio>/results}"
                                            suggestionItemSelected="onSuggeItemSelected($event, 'LISTAPRECIO')"
                                            maxSuggestionWidth="350px"
                                            startSuggestion="0"
                                            width="8rem"
                                            required="true"
                                        >
                                            <suggestionItems>
                                                <core:ListItem
                                                    key="{oDataMCListaPrecio>Pltyp}"
                                                    text="{oDataMCListaPrecio>Pltyp}"
                                                    additionalText="{oDataMCListaPrecio>Ptext}"
                                                />
                                            </suggestionItems>
                                        </Input>
                                        <Text
                                            text="{local>/ListaPrecioInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- ORG. VENTAS -->
                                <f:FormElement label="{i18n>OrgVentas1}">
                                    <f:fields>
                                        <Input
                                            value="{local>/OrgVentas}"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeOrgVentas"
                                            liveChange="onChange($event, 'OrgVentas')"
                                            showClearIcon="true"
                                            showSuggestion="true"
                                            suggestionItems="{oDataMCOrgVentas>/results}"
                                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                                            maxSuggestionWidth="350px"
                                            startSuggestion="0"
                                            maxLength="4"
                                            width="8rem"
                                        >
                                            <suggestionItems>
                                                <core:ListItem
                                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                                    text="{oDataMCOrgVentas>Vkorg}"
                                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                                />
                                            </suggestionItems>
                                        </Input>
                                        <Text
                                            text="{local>/OrgVentasInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- SECTOR -->
                                <f:FormElement label="{i18n>Sector}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Sector}"
                                            width="8rem"
                                            editable="false"
                                        />
                                        <Text
                                            text="{local>/SectorInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>


                                <!-- CANAL DISTRIBUCION -->
                                <!-- <f:FormElement label="{i18n>CanalDistrib2}">
                                    <f:fields>
                                        <Input
                                            value="{local>/CanalDist}"
                                            width="8rem"
                                            editable="false"
                                        />
                                        <Text
                                            text="{local>/CanalDistInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement> -->
                                <!-- VALIDO EL -->
                                <!-- <f:FormElement label="{i18n>ValidoEl}">
                                    <f:fields>
                                        <DatePicker
                                            required="true"
                                            placeholder="{i18n>FormatoFecha1}"
                                            width="8rem"
                                            value="{
                                            'path': 'local>/ValidoEl',
                                            'type': 'sap.ui.model.type.Date',
                                            'formatOptions': {
                                                'pattern': 'dd/MM/yyyy'
                                                }
                                            }"
                                            class="sapUiTinyMarginEnd"
                                            editable="false"
                                        />
                                    </f:fields>
                                </f:FormElement> -->
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
                <!-- BOTONES -->
                <l:Grid class="sapUiTinyMarginBottom">
                    <l:content>
                        <HBox alignItems="Center">
                            <Button
                                id="btnBuscarPRPVMob"
                                type="Success"
                                icon="sap-icon://search"
                                text="{i18n>Buscar}"
                                press=".onBuscar"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Button>
                            <layoutData>
                                <l:GridData span="L6 M6 S6" />
                            </layoutData>
                        </HBox>
                        <HBox alignItems="Center">
                            <Button
                                type="Success"
                                icon="sap-icon://clear-all"
                                text="{i18n>LimpiarCampos}"
                                press=".onLimpiarCampos"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Button>
                            <layoutData>
                                <l:GridData span="L6 M6 S6" />
                            </layoutData>
                        </HBox>
                        <HBox alignItems="Center">
                            <Button
                                type="Success"
                                icon="sap-icon://pdf-attachment"
                                text="{i18n>DescargarPDF}"
                                press=".onDescargarPDF"
                                visible="{local>/Descarga}"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Button>
                            <layoutData>
                                <l:GridData span="L12 M12 S12" />
                            </layoutData>
                        </HBox>
                    </l:content>
                </l:Grid>

                <!-- TABLA -->
                <t:Table
                    id="tblPromPrecioPorVolMob"
                    rowActionCount="1"
                    rows="{oDataPromPrecioPorVol>/reporte_promprecvol_nav/results}"
                    selectionMode="Single"
                    enableBusyIndicator="true"
                    busy="{local>/loadingTbl}"
                    sort="onTableSort"
                    filter="onTableFilter"
                    class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
                >
                    <t:columns>
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Vkorg"
                            filterProperty="Vkorg"
                            filterValue="{local>/filters/Vkorg}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>OrgVentas}" />
                            <t:template>
                                <Text
                                    text="{oDataPromPrecioPorVol>Vkorg}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Spart"
                            filterProperty="Spart"
                            filterValue="{local>/filters/Spart}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>Sector}" />
                            <t:template>
                                <Text
                                    text="{oDataPromPrecioPorVol>Spart}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="Matnr"
                            filterProperty="Matnr"
                            filterValue="{local>/filters/Matnr}"
                            hAlign="Center"
                        >
                            <!-- <Text
                                text="{i18n>MaterialCod}"
                                width="100%"
                                textAlign="Center"
                            /> -->
                            <Label text="{i18n>MaterialCod}" />
                            <t:template>
                                <Text
                                    text="{oDataPromPrecioPorVol>Matnr}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="12rem"
                            showSortMenuEntry="true"
                            sortProperty="Maktx"
                            filterProperty="Maktx"
                            filterValue="{local>/filters/Maktx}"
                        >
                            <t:label>
                                <Label text="{i18n>Material}" textAlign="Center" width="100%" />
                            </t:label>
                            <t:template>
                                <Text
                                    text="{oDataPromPrecioPorVol>Maktx}"
                                    wrapping="false"
                                    textAlign="Left"
                                    width="100%"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="CantEscala"
                            filterProperty="CantEscala"
                            filterValue="{local>/filters/CantEscala}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>CantidadEscala}" />
                            <t:template>
                                <!-- <Text
                                    text="{oDataPromPrecioPorVol>CantEscala}"
                                    wrapping="false"
                                /> -->
                                <Text
                                    text="{ 
                                    path: 'oDataPromPrecioPorVol>CantEscala',
                                    formatter : '.formatter.integer' 
                                }"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="ListaPrecio"
                            filterProperty="ListaPrecio"
                            filterValue="{local>/filters/ListaPrecio}"
                        >
                            <t:label>
                                <Label text="{i18n>PrecioEscala}" textAlign="Center" width="100%"/>
                            </t:label>

                            <t:template>
                                <!-- <Text
                                    text="{oDataPromPrecioPorVol>ListaPrecio}"
                                    wrapping="false"
                                /> -->
                                <Text
                                    text="{ 
                                    path: 'oDataPromPrecioPorVol>ListaPrecio',
                                    formatter : '.formatter.twodecimals' 
                                }"
                                    wrapping="false"
                                    textAlign="Right"
                                    width="100%"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Waers"
                            filterProperty="Waers"
                            filterValue="{local>/filters/Waers}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>Moneda}" />
                            <t:template>
                                <Text
                                    text="{oDataPromPrecioPorVol>Waers}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            showSortMenuEntry="true"
                            sortProperty="Datab"
                            filterProperty="Datab"
                            filterValue="{local>/filters/Datab}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>FechaInicio}" />
                            <t:template>
                                <Text
                                    text="{ 
                                    path: 'oDataPromPrecioPorVol>Datab',
                                    formatter : '.formatter.fecha2' 
                                }"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            showSortMenuEntry="true"
                            sortProperty="Datbi"
                            filterProperty="Datbi"
                            filterValue="{local>/filters/Datbi}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>FechaFin}" />
                            <t:template>
                                <Text
                                    text="{ 
                                    path: 'oDataPromPrecioPorVol>Datbi',
                                    formatter : '.formatter.fecha2' 
                                }"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <!-- <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="Pltyp"
                            filterProperty="Pltyp"
                            filterValue="{local>/filters/Pltyp}"
                            hAlign="Center"
                        >
                            <Label text="{i18n>ListaPrecios2}" />
                            <t:template>
                                <Text
                                    text="{oDataPromPrecioPorVol>Pltyp}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column> -->
                    </t:columns>
                </t:Table>

                <!-- PAGINACION -->
                <l:Grid class="sapUiTinyMarginTop">
                    <l:content>
                        <HBox>
                            <Button
                                type="Emphasized"
                                icon="sap-icon://close-command-field"
                                press="onFirstPress"
                                enabled="{local>/page/PrevPageBtn}"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://navigation-left-arrow"
                                press="onPreviousPress"
                                enabled="{local>/page/PrevPageBtn}"
                            />
                            <Text
                                text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                                textAlign="Center"
                                width="120px"
                                class="sapUiTinyMargin"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://navigation-right-arrow"
                                press="onNextPress"
                                enabled="{local>/page/NextPageBtn}"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://open-command-field"
                                press="onLastPress"
                                enabled="{local>/page/NextPageBtn}"
                            />
                        </HBox>
                    </l:content>
                </l:Grid>
            </VBox>
        </content>
    </Panel>
</mvc:View>