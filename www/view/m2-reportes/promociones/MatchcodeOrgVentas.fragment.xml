<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>OrgVentas}"
        liveChange=".matchcodeSearch($event, 'dialogOrgVentasPR')"
        confirm=".onConfirmPress($event, 'dialogOrgVentasPR')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCOrgVentas>/results',
			sorter : {
				path : 'Vkorg',
				descending : false
			}
		}"
        contentWidth="30%"
        contentHeight="50%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCOrgVentas>Vkorg}" />
                <Text text="{oDataMCOrgVentas>Vtext}" class="customTextLeft" />
                <Text text="{oDataMCOrgVentas>Spart}" />
                <Text text="{oDataMCOrgVentas>Vtext2}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column hAlign="Center" width="10em" >
                <header>
                    <Text text="{i18n>OrgVentas}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Denominacion}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
                width="10em"
            >
                <header>
                    <Text text="{i18n>Sector}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
                visible="false"
            >
                <header>
                    <Text text="{i18n>SectorDesc}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
