<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>OfiVentas1}"
        liveChange=".matchcodeSearch($event, 'dialogOfiVentasPR')"
        confirm=".onConfirmPress($event, 'dialogOfiVentasPR')"
        cancel=".onCancelPress"
        showClearButton="false"
        items="{
			path : 'oDataMCOfiVentas>/results',
			sorter : {
				path : 'Vkbur',
				descending : false
			}
		}"
        contentWidth="30%"
        contentHeight="50%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCOfiVentas>Vkbur}" />
                <Text text="{oDataMCOfiVentas>Bezei}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column hAlign="Center" width="8em" >
                <header>
                    <Text text="{i18n>OfiVentas}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Denominacion}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
