<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m2-reportes.Promociones"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <!-- WEB -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderR03}"
        class="custBackgroundColor"
        visible="{=!${local>/IsMobile}}"
    >
        <content>
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <!-- OFICINA VENTAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OfiVentas1}:"
                            textAlign="Initial"
                            required="true"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OfiVentas}"
                            liveChange="onChange($event, 'OfiVentas')"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeOfiVentas"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOfiVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'OFIVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOfiVentas>Vkbur}"
                                    text="{oDataMCOfiVentas>Vkbur}"
                                    additionalText="{oDataMCOfiVentas>Bezei}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/OfiVentasInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                    <!-- ORG. VENTAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OrgVentas1}:"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OrgVentas}"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeOrgVentas"
                            liveChange="onChange($event, 'OrgVentas')"
                            showClearIcon="true"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOrgVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            maxLength="4"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                    text="{oDataMCOrgVentas>Vkorg}"
                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom"
                            wrapping="false"
                            text="{local>/OrgVentasInfo}"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- SECTOR -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Sector}:"
                            textAlign="Begin"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Sector}"
                            width="8rem"
                            editable="false"
                        />
                        <Text
                            text="{local>/SectorInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- CANAL DISTRIBUCION -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>CanalDistrib2}:"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/CanalDist}"
                            editable="false"
                            width="8rem"
                        />
                        <Text
                            text="{local>/CanalDistInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- VALIDO EL -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>ValidoEl}:"
                            textAlign="Initial"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <DatePicker
                            required="true"
                            placeholder="{i18n>FormatoFecha1}"
                            width="8rem"
                            value="{
                                    'path': 'local>/ValidoEl',
                                    'type': 'sap.ui.model.type.Date',
                                    'formatOptions': {
                                        'pattern': 'dd/MM/yyyy'
                                        }
                                    }"
                            class="sapUiTinyMarginEnd"
                            editable="false"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- OFICINA VENTAS -->
                    <!-- <HBox alignItems="Center">
                        <Label
                            text="{i18n>OfiVentas1}:"
                            textAlign="Initial"
                            required="true"
                            width="160px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OfiVentas}"
                            liveChange="onChange($event, 'OfiVentas')"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeOfiVentas"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOfiVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'OFIVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            width="8rem"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOfiVentas>Vkbur}"
                                    text="{oDataMCOfiVentas>Vkbur}"
                                    additionalText="{oDataMCOfiVentas>Bezei}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/OfiVentasInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox> -->
                    <HBox
                        alignItems="Start"
                        alignContent="Center"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                    >
                        <Button
                            id="btnBuscarPR"
                            type="Success"
                            icon="sap-icon://search"
                            text="{i18n>Buscar}"
                            press=".onBuscar"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Success"
                            icon="sap-icon://clear-all"
                            text="{i18n>LimpiarCampos}"
                            press=".onLimpiarCampos"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Success"
                            icon="sap-icon://pdf-attachment"
                            text="{i18n>DescargarPDF}"
                            press=".onDescargarPDF"
                            width="12rem"
                            visible="{local>/Descarga}"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblPromociones"
                rowActionCount="1"
                rows="{oDataPromociones>/reporte_promociones_nav/results}"
                selectionMode="Single"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                sort="onTableSort"
                filter="onTableFilter"
                class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Vkorg"
                        filterProperty="Vkorg"
                        filterValue="{local>/filters/Vkorg}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OrgVentas}" />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Vkorg}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Matnr"
                        filterProperty="Matnr"
                        filterValue="{local>/filters/Matnr}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Material}" />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Matnr}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="20rem"
                        showSortMenuEntry="true"
                        sortProperty="Maktx"
                        filterProperty="Maktx"
                        filterValue="{local>/filters/Maktx}"
                    >
                        <!-- <Label text="{i18n>Denominacion}" /> -->
                        <Text
                            text="{i18n>Denominacion}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Maktx}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Knrmm"
                        filterProperty="Knrmm"
                        filterValue="{local>/filters/Knrmm}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>CtdMin}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'oDataPromociones>Knrmm',
                                    formatter : '.formatter.cantidad'
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Knrnm"
                        filterProperty="Knrnm"
                        filterValue="{local>/filters/Knrnm}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>De}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'oDataPromociones>Knrnm',
                                    formatter : '.formatter.cantidad'
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Knrme"
                        filterProperty="Knrme"
                        filterValue="{local>/filters/Knrme}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>UM-BE}" />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Knrme}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Knrzm"
                        filterProperty="Knrzm"
                        filterValue="{local>/filters/Knrzm}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>SonBonifEs}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'oDataPromociones>Knrzm',
                                    formatter : '.formatter.cantidad'
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Knrez"
                        filterProperty="Knrez"
                        filterValue="{local>/filters/Knrez}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>UmAdic}" />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Knrez}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Knrmat"
                        filterProperty="Knrmat"
                        filterValue="{local>/filters/Knrmat}"
                    >
                        <Label text="{i18n>Matadbonesp}" />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Knrmat}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="15rem"
                        showSortMenuEntry="true"
                        sortProperty="Nrmaktxt"
                        filterProperty="Nrmaktxt"
                        filterValue="{local>/filters/Nrmaktxt}"
                    >
                        <!-- <Label text="{i18n>MaterialTextoBreve}" /> -->
                        <Text
                            text="{i18n>MaterialTextoBreve}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataPromociones>Nrmaktxt}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Datab"
                        filterProperty="Datab"
                        filterValue="{local>/filters/Datab}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaInicio}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'oDataPromociones>Datab',
                                    formatter : '.formatter.fecha2' 
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Datbi"
                        filterProperty="Datbi"
                        filterValue="{local>/filters/Datbi}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaFin}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'oDataPromociones>Datbi',
                                    formatter : '.formatter.fecha2'
                                }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>
    <!-- MOBILE -->
