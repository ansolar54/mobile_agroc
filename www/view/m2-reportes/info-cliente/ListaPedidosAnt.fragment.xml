<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogPedidosICAnt"
        title="{local>/ssVerPedidos/Titulo}"
        contentWidth="70%"
        contentHeight="60%"
        draggable="true"
    >
        <l:Grid class="sapUiTinyMargin">
            <l:content>
                <HBox alignItems="Center">
                    <Label
                        text="{i18n>Desde}:"
                        textAlign="Begin"
                        width="100px"
                        class="sapUiTinyMargin"
                    />
                    <DatePicker
                        placeholder="{i18n>FormatoFecha1}"
                        displayFormat="dd/MM/yyyy"
                        valueFormat="yyyyMMdd"
                        value="{ 
                            'path': 'local>/ssVerPedidos/FechaDesde',
                            'type': 'sap.ui.model.type.Date',
                            'formatOptions': {
                                'pattern': 'dd/MM/y'
                            }
                        }"
                        width="12rem"
                    />
                    <layoutData>
                        <l:GridData span="XL6 L6 M6 S12" />
                    </layoutData>
                </HBox>
                <HBox alignItems="Center">
                    <Label
                        text="{i18n>Hasta}:"
                        textAlign="Begin"
                        width="100px"
                        class="sapUiTinyMargin"
                    />
                    <DatePicker
                        placeholder="{i18n>FormatoFecha1}"
                        displayFormat="dd/MM/yyyy"
                        valueFormat="yyyyMMdd"
                        value="{ 
                            'path': 'local>/ssVerPedidos/FechaHasta',
                            'type': 'sap.ui.model.type.Date',
                            'formatOptions': {
                                'pattern': 'dd/MM/y'
                            }
                        }"
                        width="12rem"
                    />
                    <layoutData>
                        <l:GridData span="XL6 L6 M6 S12" />
                    </layoutData>
                </HBox>
                <HBox
                    alignItems="Start"
                    alignContent="Center"
                    class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                >
                    <Button
                        type="Success"
                        icon="sap-icon://search"
                        text="{i18n>Buscar}"
                        press=".onBuscarPedidos"
                        width="12rem"
                        class="sapUiTinyMarginEnd"
                    />
                    <Button
                        type="Success"
                        icon="sap-icon://excel-attachment"
                        text="{i18n>DescargarExcel}"
                        width="12rem"
                        press=".onMatchcodeDescargar($event, 'tblListaPedidosAnt')"
                        enabled="{local>/Excel/BtnEnabled}"
                    />
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12" />
                    </layoutData>
                </HBox>
            </l:content>
        </l:Grid>
        <t:Table
            id="tblListaPedidosAnt"
            rowActionCount="1"
            rows="{oDataPedidos>/reporte_productos_nav/results}"
            enableSelectAll="true"
            enableBusyIndicator="true"
            selectionMode="None"
            sort="onTableSort"
            filter="onTableFilter"
            class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
        >
            <t:columns>
                <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Vkorg"
                        filterProperty="Vkorg"
                        filterValue="{local>/ssVerPedidos/filters/Vkorg}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OrgVentas}" />
                        <t:template>
                            <Text
                                text="{oDataPedidos>Vkorg}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Matnr"
                        filterProperty="Matnr"
                        filterValue="{local>/ssVerPedidos/filters/Matnr}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Material}" />
                        <t:template>
                            <Text
                                text="{oDataPedidos>Matnr}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="15rem"
                        showSortMenuEntry="true"
                        sortProperty="Maktx"
                        filterProperty="Maktx"
                        filterValue="{local>/ssVerPedidos/filters/Maktx}"
                    >
                        <Label text="{i18n>Denominacion}" />
                        <t:template>
                            <Text
                                text="{oDataPedidos>Maktx}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Kwmeng"
                        filterProperty="Kwmeng"
                        filterValue="{local>/ssVerPedidos/filters/Kwmeng}"
                        hAlign="End"
                    >
                        <Label text="{i18n>Cantidad}" />
                        <t:template>
                            <Text
                                text="{ path: 'oDataPedidos>Kwmeng',
                                    formatter : '.formatter.formatNumber' }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="5rem"
                        showSortMenuEntry="true"
                        sortProperty="Vrkme"
                        filterProperty="Vrkme"
                        filterValue="{local>/ssVerPedidos/filters/Vrkme}"
                        hAlign="End"
                    >
                        <Label text="{i18n>UM}" />
                        <t:template>
                            <Text
                                text="{oDataPedidos>Vrkme}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Netwr"
                        filterProperty="Netwr"
                        filterValue="{local>/ssVerPedidos/filters/Netwr}"
                        hAlign="End"
                    >
                        <Label text="{i18n>ValorNeto}" />
                        <t:template>
                            <Text
                                text="{path: 'oDataPedidos>Netwr',
                                    formatter : '.formatter.formatNumber'}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="5rem"
                        showSortMenuEntry="true"
                        sortProperty="Waerk"
                        filterProperty="Waerk"
                        filterValue="{local>/ssVerPedidos/filters/Waerk}"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Moneda}" />
                        <t:template>
                            <Text
                                text="{oDataPedidos>Waerk}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
            </t:columns>
        </t:Table>
        <beginButton>
            <Button
                type="Default"
                icon="sap-icon://decline"
                text="{i18n>Cancelar}"
                press=".onCancelPress($event, 'dialogPedidosICAnt')"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
