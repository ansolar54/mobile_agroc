<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogPdfRD"
        title="{i18n>DescargarPdf}"
        draggable="true"
    >
        <content>
            <!-- <PDFViewer
                        source="{/Source}"
                        isTrustedSource="true"
                        title="{/Title}"
                        height="{/Height}"
                    > -->
            <PDFViewer
                source="{local>/Pdf/Source}"
                isTrustedSource="true"
                title="{local>/Pdf/Title}"
                width="600px"
                height="600px"
            >
                <layoutData>
                    <FlexItemData growFactor="1" />
                </layoutData>
            </PDFViewer>
        </content>
        <beginButton>
            <Button
                type="Reject"
                icon="sap-icon://decline"
                text="{i18n>Cancelar}"
                press=".onCancelPress($event, 'dialogPdfRD')"
            />
        </beginButton>
        <!-- <endButton>
            <Button
                type="Success"
                icon="sap-icon://save"
                text="{i18n>Guardar}"
                press=".onDescargar"
            />
        </endButton> -->
    </Dialog>
</core:FragmentDefinition>
