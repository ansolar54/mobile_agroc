<core:FragmentDefinition
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
>
    <ValueHelpDialog
        id="dialogMultiComercialRD"
        title="{i18n>Comercial}"
        ok=".onOkPress($event, 'dialogMultiComercialRD')"
        cancel=".onCancelPress($event, 'dialogMultiComercialRD')"
        afterClose=".onAfterClose($event, 'dialogMultiComercialRD')"
        supportRanges="true"
        supportRangesOnly="true"
        key="Clave"
        descriptionKey="Denominacion"
        draggable="true"
    >
    </ValueHelpDialog>
</core:FragmentDefinition>
