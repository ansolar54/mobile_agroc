<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        title="{i18n>PuestoExp}"
        liveChange=".onMatchcodeSearch($event, 'dialogPuestoExpRD')"
        confirm=".onConfirmPress($event, 'dialogPuestoExpRD')"
        cancel=".onCloseDialog($event, 'dialogPuestoExpRD')"
        showClearButton="false"
        items="{
			path : 'oDataMCPuestoExp>/results',
			sorter : {
				path : 'Vstel',
				descending : false
			}
		}"
        contentWidth="30%"
        contentHeight="60%"
        draggable="true"
    >
        <ColumnListItem vAlign="Middle">
            <cells>
                <ObjectIdentifier title="{oDataMCPuestoExp>Vstel}" />
                <Text text="{oDataMCPuestoExp>Vtext}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column width="10em" hAlign="Center" >
                <header>
                    <Text text="{i18n>PuestoExp}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Denominacion}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
