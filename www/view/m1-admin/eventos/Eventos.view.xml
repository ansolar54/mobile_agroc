<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m1-admin.Eventos"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <!-- WEB -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderAD03}"
        class="custBackgroundColor"
        visible="{=!${local>/IsMobile}}"
    >
        <content>
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Buscar}:"
                            textAlign="Begin"
                            width="80px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Buscar}"
                            liveChange="onBuscar"
                            placeholder="{i18n>MsgBusquedaEvento}"
                            showClearIcon="true"
                            width="15rem"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </HBox>
                    <HBox
                        alignItems="End"
                        alignContent="Center"
                        justifyContent="End"
                    >
                        <Button
                            type="Success"
                            icon="sap-icon://add"
                            text="{i18n>NuevoEvento}"
                            tooltip="{i18n>NuevoEvento}"
                            press=".onCrearEvento"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Default"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>Refrescar}"
                            press=".onRefreshTable"
                            class="sapUiTinyMarginEnd btnRefreshUser btnIconLaunchpad borderBtnRefresh"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblEventos"
                rowActionCount="1"
                rows="{oDataEventos>/}"
                selectionMode="Single"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="3rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                    >
                        <!-- <Label text="{i18n>Id}" /> -->
                        <Text
                            text="{i18n>Id}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataEventos>Id}"
                                wrapping="true"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>                   
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="NameModul"
                        filterProperty="NameModul"
                    >
                        <Text
                            text="{i18n>Modulo}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataEventos>NameModul}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="DescAccion"
                        filterProperty="DescAccion"
                    >
                        <Text
                            text="{i18n>Descripcion}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataEventos>DescAccion}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="FCreacion"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaCreacion}" />
                        <t:template>
                            <Text
                                text="{ 
                             path: 'oDataEventos>Fechacreacion',
                             formatter : '.formatter.fecha' }"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="5rem"
                        showSortMenuEntry="true"
                        sortProperty="Estado"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Estado}" />
                        <t:template>
                            <!-- <Switch
                                type="AcceptReject"
                                state="{ path : 'oDataEventos>Estado',
                                     formatter : '.formatter.booleano'}"
                                change=".onSwitchEstado"
                            /> -->
                            <Switch
                                type="AcceptReject"
                                state="{oDataEventos>Estado}"
                                change=".onSwitchEstado"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        hAlign="Center"
                        showSortMenuEntry="true"
                        sortProperty="Action"
                    >
                        <Label text="{i18n>Accion}" />
                        <t:template>
                            <HBox justifyContent="Center">
                                <items>
                                    <Button
                                        id="btnEditEvento"
                                        type="Transparent"
                                        icon="sap-icon://edit"
                                        tooltip="{i18n>EditarEvento}"
                                        press=".onEditarEvento"
                                    />
                                    <Button
                                        id="btnEliminarEvento"
                                        type="Transparent"
                                        icon="sap-icon://delete"
                                        tooltip="{i18n>EliminarEve}"
                                        press=".onEliminarEvento"
                                    />
                                </items>
                            </HBox>
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>

    <!-- MOBILE -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderAD03}"
        class="custBackgroundColor"
        visible="{=${local>/IsMobile}}"
    >
        <content>
            <VBox class="sapUiTinyMarginBottom">
                <f:Form editable="true">
                    <f:layout>
                        <f:ColumnLayout
                            columnsM="2"
                            columnsL="2"
                            columnsXL="4"
                        />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Buscar}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Buscar}"
                                            liveChange="onBuscar"
                                            placeholder="{i18n>MsgBusquedaEvento}"
                                            showClearIcon="true"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement>
                                    <f:fields>
                                        <Button
                                            type="Success"
                                            icon="sap-icon://add"
                                            text="{i18n>NuevoEvento}"
                                            tooltip="{i18n>NuevoEvento}"
                                            press=".onCrearEvento"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Button
                                            type="Default"
                                            icon="sap-icon://refresh"
                                            tooltip="{i18n>Refrescar}"
                                            press=".onRefreshTable"
                                            class="sapUiTinyMarginEnd btnRefreshUser btnIconLaunchpad borderBtnRefresh"
                                        />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
            </VBox>
            <t:Table
                id="tblEventosmobile"
                rowActionCount="1"
                rows="{oDataEventos>/}"
                selectionMode="Single"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="3rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                    >
                        <Text
                            text="{i18n>Id}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataEventos>Id}"
                                wrapping="true"
                                width="100%"
                                textAlign="Center"
                            />
                        </t:template>
                    </t:Column>
                     <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="NameModul"
                        filterProperty="NameModul"
                    >
                        <Text
                            text="{i18n>Modulo}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataEventos>NameModul}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="DescAccion"
                        filterProperty="DescAccion"
                    >
                        <!-- <Label text="{i18n>Evento}" /> -->
                        <Text
                            text="{i18n>Evento}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataEventos>DescAccion}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="FCreacion"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaCreacion}" />
                        <t:template>
                            <Text
                                text="{ 
                             path: 'oDataEventos>Fechacreacion',
                             formatter : '.formatter.fecha' }"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="5rem"
                        showSortMenuEntry="true"
                        sortProperty="Estado"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Estado}" />
                        <t:template>
                            <Switch
                                type="AcceptReject"
                                state="{oDataEventos>Estado}"
                                change=".onSwitchEstado"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        hAlign="Center"
                        showSortMenuEntry="true"
                        sortProperty="Action"
                    >
                        <Label text="{i18n>Accion}" />
                        <t:template>
                            <HBox justifyContent="Center">
                                <items>
                                    <Button
                                        id="btnEditEventomobile"
                                        type="Transparent"
                                        icon="sap-icon://edit"
                                        tooltip="{i18n>EditarEvento}"
                                        press=".onEditarEvento"
                                    />
                                    <Button
                                        id="btnEliminarEventomobile"
                                        type="Transparent"
                                        icon="sap-icon://delete"
                                        tooltip="{i18n>EliminarEve}"
                                        press=".onEliminarEvento"
                                    />
                                </items>
                            </HBox>
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>
</mvc:View>
