<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogAsignarPerfil"
        title="{i18n>AsignarPerfil}"
        draggable="true"
    >
        <content>
            <List
                id="listPerfiles"
                items="{ path: 'oDataPerfiles>/perfil_perfiles_e_nav/results',
                        sorter: {
                            path: 'GrupoDesc',
                            descending: false,
                            group: true
                        } 
                    }"
                mode="MultiSelect"
                enableBusyIndicator="true"
            >
                <StandardListItem
                    id="listItemPerfiles"
                    title="{oDataPerfiles>NameModul}"
                    selected="{oDataPerfiles>Active}"
                >
                    <customData>
                        <core:CustomData key="{oDataPerfiles>IdModulo}" />
                    </customData>
                </StandardListItem>
            </List>
        </content>
        <beginButton>
            <Button
                type="Default"
                icon="sap-icon://decline"
                text="{i18n>Cancelar}"
                press=".onCloseDialog($event ,'dialogAsignarPerfil')"
                width="6rem"
            />
        </beginButton>
        <endButton>
            <Button
                type="Success"
                icon="sap-icon://save"
                text="{i18n>Guardar}"
                press=".onSaveAsignarPerfiles"
                width="6rem"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
