<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogCrearRol"
        title="{i18n>NuevoRol}"
        draggable="true"
    >
        <content>
            <l:Grid class="sapUiTinyMargin">
                <l:content>
                    <VBox class="sapUiTinyMarginBottom">
                        <Label
                            text="{i18n>Nombre}:"
                            textAlign="Begin"
                        />
                        <Input
                            id="txtNombreROC"
                            value="{local>/Nombre}"
                            required="true"
                            liveChange=".onChangeNombre"
                            valueStateText="El nombre es obligatorio."
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </VBox>
                </l:content>
            </l:Grid>
        </content>
        <beginButton>
            <Button
                type="Default"
                icon="sap-icon://decline"
                text="{i18n>Cancelar}"
                press=".onCloseDialog($event ,'dialogCrearRol')"
                width="6rem"
            />
        </beginButton>
        <endButton>
            <Button
                type="Success"
                icon="sap-icon://save"
                text="{i18n>Guardar}"
                press=".onSaveCrearRol"
                width="6rem"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
