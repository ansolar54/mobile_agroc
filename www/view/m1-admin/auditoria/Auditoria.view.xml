<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m1-admin.Auditoria"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <!-- WEB -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderAD04}"
        class="custBackgroundColor"
        visible="{=!${local>/IsMobile}}"
    >
        <content>
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Buscar}:"
                            textAlign="Begin"
                            width="100px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Buscar}"
                            placeholder="{i18n>MsgBusquedaAudit}"
                            showClearIcon="true"
                            width="15rem"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M12 S12" />
                        </layoutData>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>FechaDesde}:"
                            textAlign="Begin"
                            width="100px"
                            class="sapUiTinyMargin"
                        />
                        <!-- change="onChange($event, 'FDESDE')"
                            liveChange="onChange($event, 'FDESDE')" -->
                        <DatePicker
                            value="{
                                'path': 'local>/FechaDesde',
                                'type': 'sap.ui.model.type.Date',
                                'formatOptions': {
                                    'pattern': 'dd/MM/y'
                                }
                            }"
                            maxDate="{local>/FechaHasta}"
                            placeholder="{i18n>FormatoFecha1}"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M6 S12" />
                        </layoutData>
                    </HBox>

                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>FechaHasta}:"
                            textAlign="Begin"
                            width="100px"
                            class="sapUiTinyMargin"
                        />
                        <!-- enabled="{local>/visible/fhasta}" -->
                        <DatePicker
                            value="{
                                'path': 'local>/FechaHasta',
                                'type': 'sap.ui.model.type.Date',
                                'formatOptions': {
                                    'pattern': 'dd/MM/y'
                                }
                            }"
                            minDate="{local>/FechaDesde}"
                            placeholder="{i18n>FormatoFecha1}"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <layoutData>
                            <l:GridData span="XL4 L4 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- SELECIONAR ROLES -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Rol}:"
                            labelFor="mcboRoles"
                            textAlign="Begin"
                            width="100px"
                            class="sapUiTinyMargin"
                        />
                        <MultiComboBox
                            id="mcboRoles"
                            placeholder="{i18n>SeleccionarRol}"
                            items="{
                                path: 'oDataRoles>/results',
                                sorter: { path: 'Id' }
                            }"
                        >
                            <core:Item
                                key="{oDataRoles>Id}"
                                text="{oDataRoles>Nombre}"
                            />
                        </MultiComboBox>
                        <layoutData>
                            <l:GridData span="XL4 L4 M12 S12" />
                        </layoutData>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Modulo}:"
                            labelFor="mcboModulos"
                            textAlign="Begin"
                            width="100px"
                            class="sapUiTinyMargin"
                        />
                        <MultiComboBox
                            id="mcboModulos"
                            placeholder="{i18n>SeleccionarModulo}"
                            items="{
                                path: 'oDataModulos>/results',
                                sorter: { path: 'IdModulo' }
                            }"
                            selectionChange=".onChangeModulo"
                        >
                            <core:Item
                                key="{oDataModulos>IdModulo}"
                                text="{oDataModulos>NameModul}"
                            />
                        </MultiComboBox>
                        <layoutData>
                            <l:GridData span="XL4 L4 M12 S12" />
                        </layoutData>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Evento}:"
                            labelFor="mcboEventos"
                            textAlign="Begin"
                            width="100px"
                            class="sapUiTinyMargin"
                        />
                        <MultiComboBox
                            id="mcboEventos"
                            placeholder="{i18n>SeleccionarEvento}"
                            items="{
                                path: 'oDataEventos>/results',
                                sorter: { path: 'IdAccion' }
                            }"
                        >
                            <core:Item
                                key="{oDataEventos>IdAccion}"
                                text="{oDataEventos>Descripcion}"
                            />
                        </MultiComboBox>
                        <layoutData>
                            <l:GridData span="XL4 L4 M12 S12" />
                        </layoutData>
                    </HBox>

                    <!--Botones-->
                    <HBox
                        alignItems="Start"
                        alignContent="Center"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                    >
                        <Button
                            id="btnBuscarAU"
                            type="Success"
                            icon="sap-icon://search"
                            text="{i18n>Buscar}"
                            tooltip="{i18n>Buscar}"
                            press=".onBuscar($event, true)"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Success"
                            icon="sap-icon://clear-all"
                            text="{i18n>LimpiarCampos}"
                            tooltip="{i18n>LimpiarCampos}"
                            press=".onLimpiarCampos"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            id="btnDescExcel"
                            type="Success"
                            icon="sap-icon://excel-attachment"
                            text="{i18n>DescargarExcel}"
                            tooltip="{i18n>DescargarExcel}"
                            width="12rem"
                            press=".onScreenDescargaExcel"
                        />
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblAuditoria"
                rowActionCount="1"
                rows="{oDataAuditoria>/auditoria_listado_nav/results}"
                enableSelectAll="true"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                sort="onTableSort"
                class="sapUiResponsiveMarginTop"
            >
                <t:columns>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty="Nombre"
                    >
                        <!-- <Label text="{i18n>Nombres}" /> -->
                        <Text
                            text="{i18n>Nombres}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Nombre}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty=""
                        filterProperty=""
                    >
                        <!-- <Label text="{i18n>Apellidos}" /> -->
                        <Text
                            text="{i18n>Apellidos}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Apepat} {oDataAuditoria>Apemat}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Usuario"
                    >
                        <!-- <Label text="{i18n>Usuario}" /> -->
                        <Text
                            text="{i18n>Usuario}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Usuario}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty="Correo"
                    >
                        <!-- <Label text="{i18n>Correo}" /> -->
                        <Text
                            text="{i18n>Correo}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Correo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="Rol"
                    >
                        <!-- <Label text="{i18n>Rol}" /> -->
                        <Text
                            text="{i18n>Rol}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Rol}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="Modulo"
                    >
                        <Text
                            text="{i18n>Modulo}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Modulo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="Evento"
                    >
                        <!-- <Label text="{i18n>Evento}" /> -->
                        <Text
                            text="{i18n>Evento}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Evento}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        hAlign="Center"
                        showSortMenuEntry="true"
                        sortProperty="Fechacreacion"
                    >
                        <Label text="{i18n>Fecha}" />
                        <t:template>
                            <Text
                                text="{ path: 'oDataAuditoria>Fechacreacion',
                                    formatter : '.formatter.fecha' }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        hAlign="Center"
                        showSortMenuEntry="true"
                        sortProperty="Horacreacion"
                    >
                        <Label text="{i18n>Hora}" />
                        <t:template>
                            <Text
                                text="{ path: 'oDataAuditoria>Horacreacion',
                                    type : 'sap.ui.model.odata.type.Time' }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Ofiventas"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OfiVentas}" />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Ofiventas}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Indicador"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OriIngreso}" />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Indicador}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>

    <!-- MOBILE -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderAD04}"
        class="custBackgroundColor"
        visible="{=${local>/IsMobile}}"
    >
        <content>
            <VBox class="sapUiTinyMarginBottom">
                <f:Form editable="true">
                    <f:layout>
                        <f:ColumnLayout
                            columnsM="2"
                            columnsL="2"
                            columnsXL="4"
                        />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Buscar}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Buscar}"
                                            placeholder="{i18n>MsgBusquedaAudit}"
                                            showClearIcon="true"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>FechaDesde}">
                                    <f:fields>
                                        <DatePicker
                                            value="{
                                                'path': 'local>/FechaDesde',
                                                'type': 'sap.ui.model.type.Date',
                                                'formatOptions': {
                                                    'pattern': 'dd/MM/y'
                                                }
                                            }"
                                            maxDate="{local>/FechaHasta}"
                                            placeholder="{i18n>FormatoFecha1}"
                                            class="sapUiTinyMarginEnd"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>FechaHasta}">
                                    <f:fields>
                                        <DatePicker
                                            value="{
                                                'path': 'local>/FechaHasta',
                                                'type': 'sap.ui.model.type.Date',
                                                'formatOptions': {
                                                    'pattern': 'dd/MM/y'
                                                }
                                            }"
                                            minDate="{local>/FechaDesde}"
                                            placeholder="{i18n>FormatoFecha1}"
                                            class="sapUiTinyMarginEnd"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Rol}">
                                    <f:fields>
                                        <MultiComboBox
                                            id="mcboRolesmobile"
                                            placeholder="{i18n>SeleccionarRol}"
                                            items="{
                                                path: 'oDataRoles>/results',
                                                sorter: { path: 'Id' }
                                            }"
                                        >
                                            <core:Item
                                                key="{oDataRoles>Id}"
                                                text="{oDataRoles>Nombre}"
                                            />
                                        </MultiComboBox>
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Modulo}">
                                    <f:fields>
                                        <MultiComboBox
                                            id="mcboModulosmobile"
                                            placeholder="{i18n>SeleccionarModulo}"
                                            items="{
                                                path: 'oDataModulos>/results',
                                                sorter: { path: 'IdModulo' }
                                            }"
                                            selectionChange=".onChangeModulo"
                                        >
                                            <core:Item
                                                key="{oDataModulos>IdModulo}"
                                                text="{oDataModulos>NameModul}"
                                            />
                                        </MultiComboBox>
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Evento}">
                                    <f:fields>
                                        <MultiComboBox
                                            id="mcboEventosmobile"
                                            placeholder="{i18n>SeleccionarEvento}"
                                            items="{
                                                path: 'oDataEventos>/results',
                                                sorter: { path: 'IdAccion' }
                                            }"
                                        >
                                            <core:Item
                                                key="{oDataEventos>IdAccion}"
                                                text="{oDataEventos>Descripcion}"
                                            />
                                        </MultiComboBox>
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement>
                                    <f:fields>
                                        <Button
                                            id="btnBuscarAUmobile"
                                            type="Success"
                                            icon="sap-icon://search"
                                            text="{i18n>Buscar}"
                                            tooltip="{i18n>Buscar}"
                                            press=".onBuscar($event, true)"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Button
                                            id="btnLimpiarCamposmobile"
                                            type="Success"
                                            icon="sap-icon://clear-all"
                                            text="{i18n>LimpiarCampos}"
                                            tooltip="{i18n>LimpiarCampos}"
                                            press=".onLimpiarCampos"
                                            class="sapUiTinyMarginEnd"
                                        />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
            </VBox>
            <t:Table
                id="tblAuditoriamobile"
                rowActionCount="1"
                rows="{oDataAuditoria>/auditoria_listado_nav/results}"
                enableSelectAll="true"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                sort="onTableSort"
                class="sapUiResponsiveMarginTop"
            >
                <t:columns>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty="Nombre"
                    >
                        <!-- <Label text="{i18n>Nombres}" /> -->
                        <Text
                            text="{i18n>Nombres}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Nombre}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty=""
                        filterProperty=""
                    >
                        <!-- <Label text="{i18n>Apellidos}" /> -->
                        <Text
                            text="{i18n>Apellidos}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Apepat} {oDataAuditoria>Apemat}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Usuario"
                    >
                        <!-- <Label text="{i18n>Usuario}" /> -->
                        <Text
                            text="{i18n>Usuario}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Usuario}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="12rem"
                        showSortMenuEntry="true"
                        sortProperty="Correo"
                    >
                        <!-- <Label text="{i18n>Correo}" /> -->
                        <Text
                            text="{i18n>Correo}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Correo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="Rol"
                    >
                        <!-- <Label text="{i18n>Rol}" /> -->
                        <Text
                            text="{i18n>Rol}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Rol}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                     <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="Modulo"
                    >
                        <Text
                            text="{i18n>Modulo}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Modulo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="16rem"
                        showSortMenuEntry="true"
                        sortProperty="Evento"
                    >
                        <!-- <Label text="{i18n>Evento}" /> -->
                        <Text
                            text="{i18n>Evento}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Evento}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        hAlign="Center"
                        showSortMenuEntry="true"
                        sortProperty="Fechacreacion"
                    >
                        <Label text="{i18n>Fecha}" />
                        <t:template>
                            <Text
                                text="{ path: 'oDataAuditoria>Fechacreacion',
                                    formatter : '.formatter.fecha' }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        hAlign="Center"
                        showSortMenuEntry="true"
                        sortProperty="Horacreacion"
                    >
                        <Label text="{i18n>Hora}" />
                        <t:template>
                            <Text
                                text="{ path: 'oDataAuditoria>Horacreacion',
                                    type : 'sap.ui.model.odata.type.Time' }"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Ofiventas"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OfiVentas}" />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Ofiventas}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Indicador"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OriIngreso}" />
                        <t:template>
                            <Text
                                text="{oDataAuditoria>Indicador}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>
</mvc:View>