<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        noDataText="{i18n>NoDataFound}"
        liveChange=".matchcodeSearch($event, 'dialogOrgVentasRS')"
        search=".matchcodeSearch($event, 'dialogOrgVentasRS')"
        confirm=".onConfirmPress($event, 'dialogOrgVentasRS')"
        cancel=".onCancelPress($event, 'dialogOrgVentasRS')"
        showClearButton="false"
        items="{
            path : 'oDataMCOrgVentas>/results',
            sorter : {
                path : 'Vkorg',
                descending : false
            }
        }"
        contentWidth="50%"
        contentHeight="50%"
        draggable="true"
    >
        <ColumnListItem>
            <cells>
                <ObjectIdentifier title="{oDataMCOrgVentas>Vkorg}" />
                <Text text="{oDataMCOrgVentas>Vtext}" class="customTextLeft" />
                <Text text="{oDataMCOrgVentas>Spart}" />
                <Text text="{oDataMCOrgVentas>Vtext2}" class="customTextLeft" />
            </cells>
        </ColumnListItem>
        <columns>
            <Column width="12em" hAlign="Center" >
                <header>
                    <Text text="{i18n>OrgVentas}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Descripcion}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
            >
                <header>
                    <Text text="{i18n>Sector}" />
                </header>
            </Column>
            <Column
                minScreenWidth="Desktop"
                demandPopin="true"
                hAlign="Center"
                visible="false"
            >
                <header>
                    <Text text="{i18n>SectorDesc}" />
                </header>
            </Column>
        </columns>
    </TableSelectDialog>
</core:FragmentDefinition>
