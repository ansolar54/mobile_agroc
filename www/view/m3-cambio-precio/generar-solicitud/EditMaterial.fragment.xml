<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogEditMaterialGS"
        title="{i18n>EditarMaterial}"
        contentWidth="80%"
        draggable="true"
    >
        <content>
            <f:Form editable="true">
                <f:layout>
                    <f:ResponsiveGridLayout backgroundDesign="Solid" />
                </f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:layoutData>
                            <f:ColumnContainerData
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                            />
                        </f:layoutData>
                        <f:formElements>
                            <f:FormElement>
                                <!-- MATERIAL -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label
                                        text="{i18n>Material}:"
                                        required="true"
                                    />
                                    <!-- <HBox> -->
                                    <Input
                                        value="{local>/Material/MaterialInfo}"
                                        editable="false"
                                    />
                                    <!-- <Text
                                            text="{local>/Material/MaterialTxt}"
                                            wrapping="true"
                                            class="sapUiTinyMarginBegin"
                                        /> -->
                                    <!-- </HBox> -->
                                </VBox>
                                <!-- MONEDA -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>Moneda}:" />
                                    <Input
                                        value="{local>/Material/Moneda}"
                                        editable="false"
                                    />
                                </VBox>
                            </f:FormElement>
                            <f:FormElement>
                                <!-- PRECIO ACTUAL -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>PrecioActual}:" />
                                    <Input
                                        value="{
                                        path: 'local>/Material/PrecioAct',
                                        formatter : '.formatter.formatNumber'
                                    }"
                                        editable="false"
                                    />
                                </VBox>
                                <!-- LIMITE INFERIOR -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>LimiteInf}:" />
                                    <Input
                                        id="txtLimiteInferiorEdit"
                                        value="{
                                            path: 'local>/Material/LimiteInf',
                                            formatter : '.formatter.formatNumber'
                                        }"
                                        editable="false"
                                    />
                                </VBox>
                            </f:FormElement>
                            <f:FormElement>
                                <!-- PRECIO SUGERIDO -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label
                                        text="{i18n>PrecioSugerido}:"
                                        required="true"
                                    />
                                    <!-- <Input
                                        id="txtPrecioSugEdit"
                                        type="Number"
                                        value="{local>/Material/PrecioSug}"
                                        liveChange=".onValidarCampo('txtPrecioSugEdit')"
                                        valueStateText="{i18n>MsgGSValidaPrecioSug}"
                                        required="true"
                                        class="custBGColor1"
                                    /> -->
                                    <Input
                                        id="txtPrecioSugEdit1000"
                                        value="{
                                            path: 'local>/Material/PrecioSug',
                                            type: 'sap.ui.model.type.Float',
                                            formatOptions: {
                                                groupingEnabled: true,
                                                groupingSeparator: ',',
                                                decimalSeparator: '.',
                                                decimals: 2,
                                                minFractionDigits: 2,
                                                maxFractionDigits: 2
                                            }
                                        }"
                                        liveChange=".onValidarPrecio('txtPrecioSugEdit1000')"
                                        valueStateText="{i18n>MsgGSValidaPrecioSug}"
                                        required="true"
                                        class="custBGColor1"
                                        visible="{= ${local>/Sociedad} === '1000' ? true : false}"
                                    />
                                    <Input
                                        id="txtPrecioSugEdit1200"
                                        value="{
                                            path: 'local>/Material/PrecioSug',
                                            type: 'sap.ui.model.type.Float',
                                            formatOptions: {
                                                groupingEnabled: true,
                                                groupingSeparator: '.',
                                                decimalSeparator: ',',
                                                decimals: 2,
                                                minFractionDigits: 2,
                                                maxFractionDigits: 2
                                            }
                                        }"
                                        liveChange=".onValidarPrecio('txtPrecioSugEdit1200')"
                                        valueStateText="{i18n>MsgGSValidaPrecioSug}"
                                        required="true"
                                        class="custBGColor1"
                                        visible="{= ${local>/Sociedad} === '1200' ? true : false}"
                                    />
                                </VBox>
                                <!-- CANTIDAD SUGERIDA -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label
                                        text="{i18n>CantidadSug}:"
                                        required="true"
                                    />
                                    <Input
                                        id="txtCantidadSugEdit"
                                        type="Number"
                                        value="{local>/Material/CantidadSug}"
                                        liveChange=".onValidarCampo('txtCantidadSugEdit')"
                                        required="true"
                                    />
                                </VBox>
                            </f:FormElement>
                            <f:FormElement>
                                <!-- FECHA INICIO -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>FechaInicio}:" />
                                    <DatePicker
                                        editable="false"
                                        value="{
                                            path: 'local>/Material/FechaIni',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {
                                                pattern: 'dd/MM/y'
                                            }
                                        }"
                                    />
                                </VBox>
                                <!-- FECHA FIN -->
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label
                                        text="{i18n>FechaFin}:"
                                        required="true"
                                    />
                                    <DatePicker
                                        id="txtFechaFinEdit"
                                        value="{
                                            path: 'local>/Material/FechaFin',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {
                                                pattern: 'dd/MM/y'
                                            }
                                        }"
                                        change=".onValidarCampo('txtFechaFinEdit')"
                                        minDate="{local>/Material/FechaIni}"
                                        required="true"
                                    />
                                </VBox>
                            </f:FormElement>
                            <!-- NOTA -->
                            <f:FormElement>
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>Nota}:" />
                                    <TextArea
                                        value="{local>/Material/Nota}"
                                        placeholder="Nota"
                                        rows="4"
                                        width="100%"
                                    />
                                </VBox>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>
        <beginButton>
            <Button
                type="Default"
                text="{i18n>Cerrar}"
                press=".onCloseDialog($event, 'dialogEditMaterialGS')"
                width="6rem"
            />
        </beginButton>
        <endButton>
            <Button
                type="Success"
                icon="sap-icon://accept"
                text="{i18n>Ok}"
                press=".onOkPress($event, 'dialogEditMaterialGS')"
                width="6rem"
                class="sapUiTinyMarginEnd"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
