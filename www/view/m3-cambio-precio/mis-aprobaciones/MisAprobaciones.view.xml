<mvc:View
    controllerName="com.axelera.pe.gestioncomercial.controller.m3-cambio-precio.MisAprobaciones"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <!-- WEB -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderCP03}"
        class="custBackgroundColor"
        visible="{=!${local>/IsMobile}}"
    >
        <content>
            <l:Grid class="sapUiTinyMarginBottom">
                <l:content>
                    <!-- FECHA DESDE -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>FechaDesde}"
                            required="true"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <DatePicker
                            value="{
                                        path: 'local>/FechaDesde',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                        pattern: 'dd/MM/y'
                                        }
                                    }"
                            width="10rem"
                            placeholder="{i18n>FormatoFecha1}"
                            class="sapUiTinyMarginEnd"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- FECHA HASTA -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>FechaHasta}"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <DatePicker
                            value="{
                                path: 'local>/FechaHasta',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                pattern: 'dd/MM/y'
                                }
                            }"
                            width="10rem"
                            placeholder="{i18n>FormatoFecha1}"
                            class="sapUiTinyMarginEnd"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- ESTADO -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Estado}"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <ComboBox
                            selectedKey="{local>/Estado}"
                            width="10rem"
                            class="sapUiTinyMarginEnd"
                        >
                            <core:Item
                                key="0"
                                text="TODOS"
                            />
                            <core:Item
                                key="1"
                                text="APROBADO"
                            />
                            <core:Item
                                key="2"
                                text="PENDIENTE"
                            />
                            <core:Item
                                key="3"
                                text="RECHAZADO"
                            />
                            <core:Item
                                key="4"
                                text="ANULADO"
                            />
                            <core:Item
                                key="9"
                                text="ELIMINADO"
                            />
                        </ComboBox>
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- USUARIO -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Usuario}"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <ComboBox
                            id="cbxUsuario"
                            items="{
                                path: 'oDataUsuarios>/consulta_comerciales_nav/results'
                            }"
                            value="{local>/Usuario}"
                            width="10rem"
                            class="sapUiTinyMarginEnd"
                        >
                            <items>
                                <core:Item
                                    key="{oDataUsuarios>Id}"
                                    text="{oDataUsuarios>Usuario}"
                                />
                            </items>
                        </ComboBox>
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- ORG VENTAS -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>OrgVentas}"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/OrgVentas}"
                            liveChange="onChange($event, 'OrgVentas')"
                            showClearIcon="true"
                            showValueHelp="true"
                            valueHelpRequest=".onMatchcodeOrgVentas"
                            showSuggestion="true"
                            suggestionItems="{oDataMCOrgVentas>/results}"
                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                            maxSuggestionWidth="350px"
                            startSuggestion="0"
                            maxLength="4"
                            width="10rem"
                            class="sapUiTinyMarginEnd"
                        >
                            <suggestionItems>
                                <core:ListItem
                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                    text="{oDataMCOrgVentas>Vkorg}"
                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                />
                            </suggestionItems>
                        </Input>
                        <Text
                            text="{local>/OrgVentasInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- SECTOR -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>Sector}:"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/Sector}"
                            editable="false"
                            width="10rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Text
                            text="{local>/SectorInfo}"
                            wrapping="false"
                            class="sapUiTinyMargin"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <!-- NRO SOLICITUD -->
                    <HBox alignItems="Center">
                        <Label
                            text="{i18n>NSolicitud}"
                            textAlign="Begin"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Input
                            value="{local>/NroSol}"
                            width="10rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <layoutData>
                            <l:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                    </HBox>
                    <HBox
                        alignItems="Start"
                        alignContent="Center"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                    >
                        <Button
                            id="btnBuscarMA"
                            type="Success"
                            icon="sap-icon://search"
                            text="{i18n>Buscar}"
                            press="onBuscar"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Success"
                            icon="sap-icon://eraser"
                            text="{i18n>LimpiarCampos}"
                            press="onLimpiarCampos"
                            width="12rem"
                            class="sapUiTinyMarginEnd"
                        />
                        <!-- <Button
                                id="btnCFilasMA"
                                type="Success"
                                icon="sap-icon://list"
                                text="{i18n>CantFilas}"
                                width="12rem"
                                visible="false"
                                class="sapUiTinyMarginEnd"
                            /> -->
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                    </HBox>
                </l:content>
            </l:Grid>
            <t:Table
                id="tblMisAprobaciones"
                rowActionCount="1"
                rows="{local>/Solicitudes/items}"
                selectionMode="Single"
                enableBusyIndicator="true"
                busy="{local>/loadingTbl}"
                class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
            >
                <t:columns>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Accion}" />
                        <t:template>
                            <HBox justifyContent="Center">
                                <items>
                                    <Button
                                        id="btnVerDetalleSoliAprob"
                                        type="Transparent"
                                        icon="sap-icon://detail-more"
                                        tooltip="{i18n>VerDetalle}"
                                        press="onVerDetalle"
                                    />
                                    <Button
                                        id="btnAprobarSoli"
                                        type="Transparent"
                                        icon="sap-icon://accept"
                                        tooltip="{i18n>AprobarSol}"
                                        press=".onAprobarSolicitud"
                                        visible="{= ${local>Estado} === '2' ? true : false}"
                                    />
                                    <Button
                                        id="btnRechazarSoli"
                                        type="Transparent"
                                        icon="sap-icon://reset"
                                        tooltip="{i18n>RechazarSol}"
                                        press=".onRechazarSolicitud"
                                        visible="{= ${local>Estado} === '2' ? true : false}"
                                    />
                                </items>
                            </HBox>
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                        hAlign="Center"
                    >
                        <Label text="{i18n>NSolicitud}" />
                        <t:template>
                            <Text
                                text="{local>Id}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Estado}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'local>Estado',
                                    formatter : '.formatter.obtenerNombreEstado'
                                }"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                        hAlign="Center"
                    >
                        <Label text="{i18n>FechaRegistro}" />
                        <t:template>
                            <Text
                                text="{
                                    path: 'local>Fechacrea',
                                    formatter : '.formatter.fecha'
                                }"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="40rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                    >
                        <!-- <Label text="{i18n>Cliente}" /> -->
                        <Text
                            text="{i18n>Cliente}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{local>Clientetxt}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                        hAlign="Center"
                    >
                        <Label text="{i18n>OrgVentas}" />
                        <t:template>
                            <Text
                                text="{local>Orgventas}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        showSortMenuEntry="true"
                        sortProperty="Sector"
                        hAlign="Center"
                    >
                        <Label text="{i18n>Sector}" />
                        <t:template>
                            <Text
                                text="{local>Sector}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="20rem"
                        showSortMenuEntry="true"
                        sortProperty="Id"
                    >
                        <!-- <Label text="{i18n>Usuario}" /> -->
                        <Text
                            text="{i18n>Usuario}"
                            width="100%"
                            textAlign="Center"
                        />
                        <t:template>
                            <Text
                                text="{local>Usuario}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
            <l:Grid class="sapUiTinyMarginTop">
                <l:content>
                    <HBox>
                        <Button
                            type="Emphasized"
                            icon="sap-icon://close-command-field"
                            press="onFirstPress"
                            enabled="{local>/page/PrevPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-left-arrow"
                            press="onPreviousPress"
                            enabled="{local>/page/PrevPageBtn}"
                        />
                        <Text
                            text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                            textAlign="Center"
                            width="120px"
                            class="sapUiTinyMargin"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://navigation-right-arrow"
                            press="onNextPress"
                            enabled="{local>/page/NextPageBtn}"
                            class="sapUiTinyMarginEnd"
                        />
                        <Button
                            type="Emphasized"
                            icon="sap-icon://open-command-field"
                            press="onLastPress"
                            enabled="{local>/page/NextPageBtn}"
                        />
                    </HBox>
                </l:content>
            </l:Grid>
        </content>
    </Panel>

    <!-- MOBILE -->
    <Panel
        accessibleRole="Region"
        headerText="{i18n>HeaderCP03}"
        class="custBackgroundColor"
        visible="{=${local>/IsMobile}}"
    >
        <content>
            <VBox>
                <f:Form editable="true">
                    <!-- <f:title>
                        <core:Title text="{i18n>HeaderCP03}" />
                    </f:title> -->
                    <f:layout>
                        <f:ColumnLayout
                            columnsM="2"
                            columnsL="2"
                            columnsXL="4"
                        />
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>FechaDesdeHasta}">
                                    <f:fields>
                                        <DatePicker
                                            required="true"
                                            value="{
                                path: 'local>/FechaDesde',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                pattern: 'dd/MM/y'
                                }
                            }"
                                            maxDate="{local>/FechaHasta}"
                                            placeholder="{i18n>FormatoFecha1}"
                                        />
                                        <DatePicker
                                            value="{
                                path: 'local>/FechaHasta',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                pattern: 'dd/MM/y'
                                }
                            }"
                                            minDate="{local>/FechaDesde}"
                                            placeholder="{i18n>FormatoFecha1}"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <!-- <f:FormElement label="{i18n>FechaHasta}">
                            <f:fields>
                                <DatePicker
                                    value="{
                                path: 'local>/FechaHasta',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                pattern: 'dd/MM/y'
                                }
                            }"
                                    placeholder="{i18n>FormatoFecha1}"
                                />
                            </f:fields>
                        </f:FormElement> -->
                                <f:FormElement label="{i18n>Estado}">
                                    <f:fields>
                                        <ComboBox selectedKey="{local>/Estado}">
                                            <core:Item
                                                key="0"
                                                text="TODOS"
                                            />
                                            <core:Item
                                                key="1"
                                                text="APROBADO"
                                            />
                                            <core:Item
                                                key="2"
                                                text="PENDIENTE"
                                            />
                                            <core:Item
                                                key="3"
                                                text="RECHAZADO"
                                            />
                                            <core:Item
                                                key="4"
                                                text="ANULADO"
                                            />
                                            <core:Item
                                                key="9"
                                                text="ELIMINADO"
                                            />
                                        </ComboBox>
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Usuario}">
                                    <f:fields>
                                        <ComboBox
                                            id="cbxUsuarioMob"
                                            items="{
                                path: 'oDataUsuarios>/consulta_comerciales_nav/results'
                            }"
                                            value="{local>/Usuario}"
                                        >
                                            <items>
                                                <core:Item
                                                    key="{oDataUsuarios>Id}"
                                                    text="{oDataUsuarios>Usuario}"
                                                />
                                            </items>
                                        </ComboBox>
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>OrgVentas}">
                                    <f:fields>
                                        <Input
                                            value="{local>/OrgVentas}"
                                            liveChange="onChange($event, 'OrgVentas')"
                                            showClearIcon="true"
                                            showValueHelp="true"
                                            valueHelpRequest=".onMatchcodeOrgVentas"
                                            showSuggestion="true"
                                            suggestionItems="{oDataMCOrgVentas>/results}"
                                            suggestionItemSelected="onSuggeItemSelected($event, 'ORGVENTAS')"
                                            maxSuggestionWidth="350px"
                                            startSuggestion="0"
                                            maxLength="4"
                                        >
                                            <suggestionItems>
                                                <core:ListItem
                                                    key="{oDataMCOrgVentas>Vkorg}|{oDataMCOrgVentas>Spart}"
                                                    text="{oDataMCOrgVentas>Vkorg}"
                                                    additionalText="{oDataMCOrgVentas>Vtext} - {oDataMCOrgVentas>Spart}"
                                                />
                                            </suggestionItems>
                                        </Input>
                                        <Text
                                            text="{local>/OrgVentasInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Sector}">
                                    <f:fields>
                                        <Input
                                            value="{local>/Sector}"
                                            editable="false"
                                        />
                                        <Text
                                            text="{local>/SectorInfo}"
                                            wrapping="false"
                                        />
                                    </f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>NSolicitud}">
                                    <f:fields>
                                        <Input value="{local>/NroSol}" />
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>
                <!-- BOTON AGREGAR MATERIAL Y LIMPIAR CAMPOS -->
                <l:Grid class="sapUiTinyMarginBottom">
                    <l:content>
                        <HBox alignItems="Center">
                            <items>
                                <Button
                                    id="btnBuscarMAMob"
                                    type="Success"
                                    icon="sap-icon://search"
                                    text="{i18n>Buscar}"
                                    press=".onBuscar"
                                    width="100%"
                                >
                                    <layoutData>
                                        <FlexItemData growFactor="1" />
                                    </layoutData>
                                </Button>
                            </items>
                            <layoutData>
                                <l:GridData span="L6 M6 S6" />
                            </layoutData>
                        </HBox>
                        <HBox alignItems="Center">
                            <Button
                                type="Success"
                                icon="sap-icon://eraser"
                                text="{i18n>LimpiarCampos}"
                                press=".onLimpiarCampos"
                                width="100%"
                            >
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Button>
                            <layoutData>
                                <l:GridData span="L6 M6 S6" />
                            </layoutData>
                        </HBox>
                    </l:content>
                </l:Grid>
                <!-- TABLA -->
                <t:Table
                    id="tblMisAprobacionesMob"
                    rowActionCount="1"
                    rows="{local>/Solicitudes/items}"
                    selectionMode="Single"
                    enableBusyIndicator="true"
                    busy="{local>/loadingTbl}"
                    class="sapUiResponsiveMarginTop sapUiResponsiveMarginBottom"
                >
                    <t:columns>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                            hAlign="Center"
                        >
                            <Label text="{i18n>Accion}" />
                            <t:template>
                                <HBox justifyContent="Center">
                                    <items>
                                        <Button
                                            id="btnVerDetalleSoliAprobMob"
                                            type="Transparent"
                                            icon="sap-icon://detail-more"
                                            tooltip="{i18n>VerDetalle}"
                                            press="onVerDetalle"
                                        />
                                        <Button
                                            id="btnAprobarSoliMob"
                                            type="Transparent"
                                            icon="sap-icon://accept"
                                            tooltip="{i18n>AprobarSol}"
                                            press=".onAprobarSolicitud"
                                            visible="{= ${local>Estado} === '2' ? true : false}"
                                        />
                                        <Button
                                            id="btnRechazarSoliMob"
                                            type="Transparent"
                                            icon="sap-icon://reset"
                                            tooltip="{i18n>RechazarSol}"
                                            press=".onRechazarSolicitud"
                                            visible="{= ${local>Estado} === '2' ? true : false}"
                                        />
                                    </items>
                                </HBox>
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                            hAlign="Center"
                        >
                            <Label text="{i18n>NSolicitud}" />
                            <t:template>
                                <Text
                                    text="{local>Id}"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                            hAlign="Center"
                        >
                            <Label text="{i18n>Estado}" />
                            <t:template>
                                <Text
                                    text="{
                                    path: 'local>Estado',
                                    formatter : '.formatter.obtenerNombreEstado'
                                }"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                            hAlign="Center"
                        >
                            <Label text="{i18n>FechaRegistro}" />
                            <t:template>
                                <Text
                                    text="{
                                    path: 'local>Fechacrea',
                                    formatter : '.formatter.fecha'
                                }"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="40rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                        >
                            <!-- <Label text="{i18n>Cliente}" /> -->
                            <Text
                                text="{i18n>Cliente}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{local>Clientetxt}"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                            hAlign="Center"
                        >
                            <Label text="{i18n>OrgVentas}" />
                            <t:template>
                                <Text
                                    text="{local>Orgventas}"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            showSortMenuEntry="true"
                            sortProperty="Sector"
                            hAlign="Center"
                        >
                            <Label text="{i18n>Sector}" />
                            <t:template>
                                <Text
                                    text="{local>Sector}"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="20rem"
                            showSortMenuEntry="true"
                            sortProperty="Id"
                        >
                            <!-- <Label text="{i18n>Usuario}" /> -->
                            <Text
                                text="{i18n>Usuario}"
                                width="100%"
                                textAlign="Center"
                            />
                            <t:template>
                                <Text
                                    text="{local>Usuario}"
                                    wrapping="true"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
                <!-- PAGINADO -->
                <l:Grid class="sapUiTinyMarginTop">
                    <l:content>
                        <HBox
                            alignContent="Center"
                            alignItems="Center"
                            justifyContent="Center"
                        >
                            <Button
                                type="Emphasized"
                                icon="sap-icon://close-command-field"
                                press="onFirstPress"
                                enabled="{local>/page/PrevPageBtn}"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://navigation-left-arrow"
                                press="onPreviousPress"
                                enabled="{local>/page/PrevPageBtn}"
                            />
                            <Text
                                text="{i18n>Pagina} {local>/page/Page} de {local>/page/TotalPages}"
                                textAlign="Center"
                                width="120px"
                                class="sapUiTinyMargin"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://navigation-right-arrow"
                                press="onNextPress"
                                enabled="{local>/page/NextPageBtn}"
                                class="sapUiTinyMarginEnd"
                            />
                            <Button
                                type="Emphasized"
                                icon="sap-icon://open-command-field"
                                press="onLastPress"
                                enabled="{local>/page/NextPageBtn}"
                            />
                            <layoutData>
                                <l:GridData span="XL12 L12 M12 S12" />
                            </layoutData>
                        </HBox>
                    </l:content>
                </l:Grid>
            </VBox>
        </content>
    </Panel>
</mvc:View>
