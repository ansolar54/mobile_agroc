<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="dialogVerNotaMS"
        title="{i18n>VerNota}"
        contentWidth="50%"
        draggable="true"
    >
        <content>
            <f:Form editable="true">
                <f:layout>
                    <f:ResponsiveGridLayout backgroundDesign="Solid" />
                </f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:layoutData>
                            <f:ColumnContainerData
                                columnsXL="2"
                                columnsL="2"
                                columnsM="1"
                            />
                        </f:layoutData>
                        <f:formElements>
                            <!-- NOTA -->
                            <f:FormElement>
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>Nota}:" />
                                    <TextArea
                                        value="{local>/Nota}"
                                        placeholder="Nota"
                                        rows="4"
                                        width="100%"
                                        editable="false"
                                    />
                                </VBox>
                            </f:FormElement>
                            <!-- NOTA RESPUESTA-->
                            <f:FormElement>
                                <VBox class="sapUiTinyMarginBottom">
                                    <Label text="{i18n>NotaResp}:" />
                                    <TextArea
                                        value="{local>/NotaResp}"
                                        placeholder="Respuesta (opcional)"
                                        rows="4"
                                        width="100%"
                                        editable="false"
                                    />
                                </VBox>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>
        <beginButton>
            <Button
                type="Default"
                text="{i18n>Cerrar}"
                press=".onCloseDialog($event, 'dialogVerNotaMS')"
                width="6rem"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
